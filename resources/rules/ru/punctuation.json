{
  "schemaVersion": 1,
  "packVersion": "ru-1.0.0",
  "language": "ru",
  "rules": [
    {
      "ruleId": "ru.spacing.repeated-space", "language": "ru", "category": "ExtraSpace", "issueCategory": "Readability",
      "title": "Лишние пробелы", "shortMessage": "Между словами больше одного пробела.",
      "detailedExplanation": "В обычном русском тексте между словами используется один пробел.",
      "badExamples": ["два  слова"], "goodExamples": ["два слова"], "severity": "Error",
      "suggestions": ["Оставить один пробел."], "safeToApply": true, "source": "Авторское правило WriteLite.",
      "implementation": { "engine": "regex", "pattern": "[ \\t\\u00A0]{2,}", "replacement": " " },
      "tests": [
        { "name": "double", "input": "два  слова", "shouldMatch": true, "expectedSuggestion": " " },
        { "name": "single", "input": "два слова", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.space-before-mark", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Punctuation",
      "title": "Пробел перед знаком", "shortMessage": "Перед знаком препинания пробел не ставится.",
      "detailedExplanation": "Перед запятой, точкой, двоеточием, точкой с запятой, вопросительным или восклицательным знаком пробел не нужен.",
      "badExamples": ["слово ,"], "goodExamples": ["слово,"], "severity": "Error",
      "suggestions": ["Убрать пробел перед знаком."], "safeToApply": true, "source": "Авторское правило WriteLite.",
      "implementation": { "engine": "regex", "pattern": "[ \\t\\u00A0]+([,.;:!?])", "replacement": "$1" },
      "tests": [
        { "name": "comma", "input": "слово ,", "shouldMatch": true, "expectedSuggestion": "," },
        { "name": "normal", "input": "слово,", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.space-after-mark", "language": "ru", "category": "MissingSpace", "issueCategory": "Punctuation",
      "title": "Нет пробела после знака", "shortMessage": "После знака препинания нужен пробел.",
      "detailedExplanation": "Между знаком препинания и следующим русским словом обычно ставится пробел.",
      "badExamples": ["да,нет"], "goodExamples": ["да, нет"], "severity": "Error",
      "suggestions": ["Добавить один пробел."], "safeToApply": true, "source": "Авторское правило WriteLite.",
      "implementation": { "engine": "regex", "pattern": "([,;:!?])(?=[А-Яа-яЁё])", "replacement": "$1 " },
      "tests": [
        { "name": "comma", "input": "да,нет", "shouldMatch": true, "expectedSuggestion": ", " },
        { "name": "normal", "input": "да, нет", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.repeated-mark", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Punctuation",
      "title": "Повтор знака", "shortMessage": "Знак препинания повторён.",
      "detailedExplanation": "Повтор вопросительных и восклицательных знаков может быть намеренной экспрессией, поэтому исправление требует подтверждения.",
      "badExamples": ["Правда???"], "goodExamples": ["Правда?"], "severity": "Suggestion",
      "suggestions": ["Оставить один знак, если повтор не передаёт интонацию."], "safeToApply": false, "source": "Авторская эвристика WriteLite.",
      "implementation": { "engine": "regex", "pattern": "([!?.,])\\1+", "replacement": "$1" },
      "tests": [
        { "name": "repeated", "input": "Правда???", "shouldMatch": true, "expectedSuggestion": "?" },
        { "name": "single", "input": "Правда?", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.typography.ellipsis", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Readability",
      "title": "Многоточие", "shortMessage": "Три точки можно заменить знаком многоточия.",
      "detailedExplanation": "Типографский знак «…» часто предпочтительнее трёх отдельных точек, но это стилистическая правка.",
      "badExamples": ["Ну..."], "goodExamples": ["Ну…"], "severity": "Suggestion",
      "suggestions": ["…"], "safeToApply": false, "source": "Авторская типографская рекомендация WriteLite.",
      "implementation": { "engine": "regex", "pattern": "\\.{3,}", "replacement": "…" },
      "tests": [
        { "name": "three-dots", "input": "Ну...", "shouldMatch": true, "expectedSuggestion": "…" },
        { "name": "version", "input": "Версия 1.2.3", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.typography.double-hyphen", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Readability",
      "title": "Два дефиса вместо тире", "shortMessage": "Два дефиса могут обозначать тире.",
      "detailedExplanation": "В обычном тексте вместо двух дефисов используют тире. В коде и командной строке правило подавляется защищёнными диапазонами.",
      "badExamples": ["да -- нет"], "goodExamples": ["да — нет"], "severity": "Suggestion",
      "suggestions": ["—"], "safeToApply": false, "source": "Авторская типографская рекомендация WriteLite.",
      "implementation": { "engine": "regex", "pattern": "(?<!-)--(?!-)", "replacement": "—" },
      "tests": [
        { "name": "plain-text", "input": "да -- нет", "shouldMatch": true, "expectedSuggestion": "—" },
        { "name": "typographic", "input": "да — нет", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.open-paren-space", "language": "ru", "category": "ExtraSpace", "issueCategory": "Punctuation",
      "title": "Пробел после открывающей скобки", "shortMessage": "После открывающей скобки пробел не нужен.",
      "detailedExplanation": "Текст внутри круглых скобок обычно начинается без пробела.",
      "badExamples": ["( текст)"], "goodExamples": ["(текст)"], "severity": "Error",
      "suggestions": ["Убрать пробел."], "safeToApply": true, "source": "Авторское правило WriteLite.",
      "implementation": { "engine": "regex", "pattern": "\\([ \\t\\u00A0]+", "replacement": "(" },
      "tests": [
        { "name": "space", "input": "( текст)", "shouldMatch": true, "expectedSuggestion": "(" },
        { "name": "normal", "input": "(текст)", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.close-paren-space", "language": "ru", "category": "ExtraSpace", "issueCategory": "Punctuation",
      "title": "Пробел перед закрывающей скобкой", "shortMessage": "Перед закрывающей скобкой пробел не нужен.",
      "detailedExplanation": "Текст внутри круглых скобок обычно заканчивается без пробела.",
      "badExamples": ["(текст )"], "goodExamples": ["(текст)"], "severity": "Error",
      "suggestions": ["Убрать пробел."], "safeToApply": true, "source": "Авторское правило WriteLite.",
      "implementation": { "engine": "regex", "pattern": "[ \\t\\u00A0]+\\)", "replacement": ")" },
      "tests": [
        { "name": "space", "input": "(текст )", "shouldMatch": true, "expectedSuggestion": ")" },
        { "name": "normal", "input": "(текст)", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.open-quote-space", "language": "ru", "category": "ExtraSpace", "issueCategory": "Punctuation",
      "title": "Пробел после открывающей кавычки", "shortMessage": "После « пробел не нужен.",
      "detailedExplanation": "Текст внутри русских кавычек начинается без пробела.",
      "badExamples": ["« текст»"], "goodExamples": ["«текст»"], "severity": "Error",
      "suggestions": ["Убрать пробел."], "safeToApply": true, "source": "Авторское правило WriteLite.",
      "implementation": { "engine": "regex", "pattern": "«[ \\t\\u00A0]+", "replacement": "«" },
      "tests": [
        { "name": "space", "input": "« текст»", "shouldMatch": true, "expectedSuggestion": "«" },
        { "name": "normal", "input": "«текст»", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.close-quote-space", "language": "ru", "category": "ExtraSpace", "issueCategory": "Punctuation",
      "title": "Пробел перед закрывающей кавычкой", "shortMessage": "Перед » пробел не нужен.",
      "detailedExplanation": "Текст внутри русских кавычек заканчивается без пробела.",
      "badExamples": ["«текст »"], "goodExamples": ["«текст»"], "severity": "Error",
      "suggestions": ["Убрать пробел."], "safeToApply": true, "source": "Авторское правило WriteLite.",
      "implementation": { "engine": "regex", "pattern": "[ \\t\\u00A0]+»", "replacement": "»" },
      "tests": [
        { "name": "space", "input": "«текст »", "shouldMatch": true, "expectedSuggestion": "»" },
        { "name": "normal", "input": "«текст»", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.abbreviation-td", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Punctuation",
      "title": "Сокращение «т. д.»", "shortMessage": "Между частями сокращения нужен пробел.",
      "detailedExplanation": "Общепринятое оформление сокращения: «т. д.».",
      "badExamples": ["т.д."], "goodExamples": ["т. д."], "severity": "Error",
      "suggestions": ["т. д."], "safeToApply": true, "source": "Авторское правило WriteLite; общепринятая русская орфография.",
      "implementation": { "engine": "regex", "pattern": "\\bт\\.д\\.", "replacement": "т. д.", "ignoreCase": true },
      "tests": [
        { "name": "compact", "input": "и т.д.", "shouldMatch": true, "expectedSuggestion": "т. д." },
        { "name": "normal", "input": "и т. д.", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.abbreviation-te", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Punctuation",
      "title": "Сокращение «т. е.»", "shortMessage": "Между частями сокращения нужен пробел.",
      "detailedExplanation": "Общепринятое оформление сокращения: «т. е.».",
      "badExamples": ["т.е."], "goodExamples": ["т. е."], "severity": "Error",
      "suggestions": ["т. е."], "safeToApply": true, "source": "Авторское правило WriteLite; общепринятая русская орфография.",
      "implementation": { "engine": "regex", "pattern": "\\bт\\.е\\.", "replacement": "т. е.", "ignoreCase": true },
      "tests": [
        { "name": "compact", "input": "т.е. пример", "shouldMatch": true, "expectedSuggestion": "т. е." },
        { "name": "normal", "input": "т. е. пример", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.orthography.sentence-capital", "language": "ru", "category": "EndingError", "issueCategory": "Orthography",
      "title": "Регистр в начале предложения", "shortMessage": "Предложение обычно начинается с заглавной буквы.",
      "detailedExplanation": "Строчная буква после завершённого предложения может быть ошибкой, но регистр иногда выбран намеренно, поэтому исправление требует подтверждения.",
      "badExamples": ["Первое. второе."], "goodExamples": ["Первое. Второе."], "severity": "Warning",
      "suggestions": ["Начать предложение с заглавной буквы."], "safeToApply": false, "source": "Авторская эвристика WriteLite.",
      "implementation": { "engine": "builtin" },
      "tests": [
        { "name": "lowercase", "input": "Первое. второе.", "shouldMatch": true, "expectedSuggestion": "Второе" },
        { "name": "uppercase", "input": "Первое. Второе.", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.terminal.insert", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Punctuation",
      "title": "Возможно, нет знака в конце", "shortMessage": "В конце предложения может отсутствовать знак.",
      "detailedExplanation": "В конце законченного предложения ставят точку, вопросительный или восклицательный знак. Тип знака зависит от смысла, поэтому автоматическая правка отключена.",
      "badExamples": ["Это законченное предложение без точки"], "goodExamples": ["Это законченное предложение с точкой."], "severity": "Suggestion",
      "suggestions": ["Добавить подходящий конечный знак."], "safeToApply": false, "source": "Авторская эвристика WriteLite.",
      "implementation": { "engine": "builtin" },
      "tests": [
        { "name": "missing", "input": "Это законченное предложение без точки", "shouldMatch": true, "expectedSuggestion": "." },
        { "name": "present", "input": "Это законченное предложение с точкой.", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.comma-before-chtoby", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Punctuation",
      "title": "Запятая перед «чтобы»", "shortMessage": "Перед придаточной частью цели нужна запятая.",
      "detailedExplanation": "Перед придаточной частью цели с союзом «чтобы» нужна запятая. Правило использует ограниченный контекст.",
      "badExamples": ["Он пришёл чтобы помочь."], "goodExamples": ["Он пришёл, чтобы помочь.", "Чтобы помочь, он пришёл."], "severity": "Error",
      "suggestions": ["Вставить запятую перед «чтобы»."], "safeToApply": true, "source": "Авторское контекстное правило WriteLite.",
      "implementation": { "engine": "builtin" },
      "tests": [
        { "name": "purpose", "input": "Он пришёл чтобы помочь.", "shouldMatch": true, "expectedSuggestion": "," },
        { "name": "initial", "input": "Чтобы помочь, он пришёл.", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.intro-comma.info", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Punctuation",
      "title": "Возможна пропущенная запятая", "shortMessage": "Проверьте границу частей предложения.",
      "detailedExplanation": "После начальной придаточной части часто нужна запятая. Эвристика только отмечает место для ручной проверки.",
      "badExamples": ["Когда закончилось занятие мы ушли."], "goodExamples": ["Когда закончилось занятие, мы ушли."], "severity": "Suggestion",
      "suggestions": ["Проверить, нужна ли запятая на границе частей."], "safeToApply": false, "source": "Авторская эвристика WriteLite.",
      "implementation": { "engine": "builtin" },
      "tests": [
        { "name": "possible", "input": "Когда закончилось занятие мы ушли.", "shouldMatch": true },
        { "name": "present", "input": "Когда закончилось занятие, мы ушли.", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.subordinate-comma", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Punctuation",
      "title": "Возможна запятая перед союзом", "shortMessage": "Проверьте границу придаточной части.",
      "detailedExplanation": "Запятая перед союзом зависит от синтаксической структуры. Даже при предложенной замене правило не применяется автоматически.",
      "badExamples": ["Я думаю что это важно."], "goodExamples": ["Я думаю, что это важно."], "severity": "Suggestion",
      "suggestions": ["Проверить запятую перед союзом."], "safeToApply": false, "source": "Авторская эвристика WriteLite.",
      "implementation": { "engine": "builtin" },
      "tests": [
        { "name": "possible", "input": "Я думаю что это важно.", "shouldMatch": true },
        { "name": "present", "input": "Я думаю, что это важно.", "shouldMatch": false }
      ]
    },
    {
      "ruleId": "ru.punctuation.subordinate-comma.info", "language": "ru", "category": "PunctuationRecommendation", "issueCategory": "Punctuation",
      "title": "Возможна граница придаточной части", "shortMessage": "Проверьте пунктуацию перед союзом.",
      "detailedExplanation": "Структура предложения неоднозначна, поэтому WriteLite не предлагает автоматическое исправление.",
      "badExamples": ["Мы продолжим если будет время."], "goodExamples": ["Мы продолжим, если будет время."], "severity": "Suggestion",
      "suggestions": ["Проверить структуру предложения вручную."], "safeToApply": false, "source": "Авторская эвристика WriteLite.",
      "implementation": { "engine": "builtin" },
      "tests": [
        { "name": "possible", "input": "Мы продолжим если будет время.", "shouldMatch": true },
        { "name": "initial", "input": "Если будет время, мы продолжим.", "shouldMatch": false }
      ]
    }
  ]
}

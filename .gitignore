# Reranker training artefacts (the shipped model.onnx/vocab.txt/reranker.json stay tracked)
models/writelight-reranker/hf/
models/writelight-reranker/model.fp32.onnx
models/writelight-reranker/model.inlined.onnx
models/writelight-reranker/*.onnx.data
ai/models/rubert-tiny2/
ai/.wheels/

# Locally cached NuGet packages and wheels (restore normally comes from nuget.org / PyPI)
ai/.nupkgs/

# Generated lexical intermediates: rebuilt by ai/scripts/extract_opencorpora_forms.py
ai/data/lexical/opencorpora-forms.tsv
ai/data/lexical/opencorpora-forms.tsv.stats.json
ai/data/lexical/_smoke-forms.tsv

# Downloaded frequency source (normalised result ships as resources/lexical/ru-frequency.tsv)
ai/data/frequency/

# Punctuation-model training checkpoints (PUNC-A/B/C, 371 MB). The weights are already
# excluded by *.onnx / *.safetensors above, but the checkpoints also carry ~7 MB of
# tokenizer.json and .npy validation arrays that nothing in the product reads.
# The accepted model ships as models/writelite-punctuation/{punctuation.json,vocab.txt}
# plus the ONNX file, which is built by ai/scripts and never committed.
# Training evidence for all three runs is kept in experiments/PUNC-*/report.json.
models/writelite-punctuation/PUNC-*/


# --- Build artifacts and large binaries (never commit) ---
# artifacts/ holds ~18 GB of publish output, llama.cpp builds and release bundles.
# All of it is reproducible from source; keep it out of history.
artifacts/
**/artifacts/

# Model weights. Reproducible via ai/scripts/*; multi-GB each.
*.gguf
*.safetensors
*.bin
models/writelight-qwen/merged-hf/
models/writelight-qwen-polish-staging/

# Generated lexical packs. Rebuild:
#   python ai/scripts/build_open_lexical_pack.py --wiktionary ai/data/lexical/ru-wiktionary-20260801.jsonl
#   python ai/scripts/build_en_lexical_pack.py
# Hashes and entry counts are recorded in resources/lexical/sources.manifest.json
# and verified by LexicalProvenanceTests.
resources/lexical/writelight-lexical-open.json
resources/lexical/writelight-lexical-en.json

# Intermediate ETL layer (61 MB). Rebuild: python ai/scripts/extract_ru_wiktionary.py
ai/data/lexical/*.jsonl

# Runtime lexical database (145 MB), built from the JSON packs above.
# Rebuild: python ai/scripts/build_lexical_sqlite.py
resources/lexical/*.db

# Duplicated dictionary inputs; canonical copies live in resources/
tools/build-spelling/*.aff
tools/build-spelling/*.dic
tools/resources/

# Local runtime state
*.pid
*.log
**/TestResults/
# Dependencies and build results
**/node_modules/
**/bin/
**/obj/
**/.vs/
**/TestResults/
**/dist/
**/.next/


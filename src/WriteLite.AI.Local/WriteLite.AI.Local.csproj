<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WriteLite.AI.Local</RootNamespace>
    <AssemblyName>WriteLite.AI.Local</AssemblyName>
    <Description>Offline local text correction runtime for WriteLite (no Python at runtime).</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- CandidateJudge's answer parsing is internal: it is a wire contract, not API. The
         rejection paths are the part that has to be tested, so the test project sees it. -->
    <InternalsVisibleTo Include="WriteLite.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WriteLite.AI.Contracts\WriteLite.AI.Contracts.csproj" />

    <!-- LinguisticDiff. Language.Core has no dependencies of its own, and one word-aware
         diff shared by both AI paths is the point: two implementations drift, and the
         drift is invisible until a benchmark blames the model for it. -->
    <ProjectReference Include="..\WriteLite.Language.Core\WriteLite.Language.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Models\lite-rules.json" LogicalName="WriteLite.AI.Local.Models.lite-rules.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WriteLite.AI.Local</RootNamespace>
    <AssemblyName>WriteLite.AI.Local</AssemblyName>
    <Description>Offline local text correction runtime for WriteLite (no Python at runtime).</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WriteLite.AI.Contracts\WriteLite.AI.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Models\lite-rules.json" LogicalName="WriteLite.AI.Local.Models.lite-rules.json" />
  </ItemGroup>
</Project>

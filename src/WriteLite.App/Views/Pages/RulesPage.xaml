<UserControl x:Class="WriteLite.Views.Pages.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WriteLite.Controls"
             xmlns:res="clr-namespace:WriteLite.Resources"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}">
    <!--
        The rules reference. Every correction card names a rule and links here, so this
        page is where "why is this an error" gets its full answer: the rule in a sentence,
        the reasoning, examples, and the published source it follows.

        Entries are closed by default and open in place. A wall of seventy explanations is
        not a reference anyone reads; a list of rule names that opens where you point is.
        The search field is pinned above the list for the same reason as on the dictionary
        page — a reference is used by looking things up.
    -->
    <UserControl.Resources>
        <!-- An entry's title row: the whole row is the target, with no button chrome. -->
        <Style x:Key="RuleRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="Transparent" Padding="0,12,0,12"
                                BorderBrush="Transparent" BorderThickness="0,0,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource WlHover}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource WlHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="36,30,36,0" MaxWidth="880" HorizontalAlignment="Left">
            <controls:SectionHeader Index="07"
                                    Title="{x:Static res:Strings.Nav_Rules}"
                                    Description="{x:Static res:Strings.Rules_Description}"
                                    ShowRule="False" />

            <TextBox x:Name="SearchBox"
                     Style="{DynamicResource WlSearchInput}"
                     MinHeight="40"
                     FontSize="14"
                     Margin="0,18,0,0"
                     Tag="{x:Static res:Strings.Rules_SearchPlaceholder}"
                     TextChanged="SearchBox_TextChanged"
                     AutomationProperties.Name="{x:Static res:Strings.Rules_SearchAutomation}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="ListScroll" Style="{DynamicResource WlScrollViewer}">
            <StackPanel Margin="36,8,36,44" MaxWidth="880" HorizontalAlignment="Left">
                <StackPanel x:Name="SectionsHost" />
                <TextBlock x:Name="EmptyText"
                           Style="{DynamicResource WlSecondary}"
                           Foreground="{DynamicResource WlTextMuted}"
                           Text="{x:Static res:Strings.Rules_NothingFound}"
                           Margin="0,24,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

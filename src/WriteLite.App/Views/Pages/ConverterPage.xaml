<UserControl x:Class="WriteLite.Views.Pages.ConverterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WriteLite.Controls"
             xmlns:res="clr-namespace:WriteLite.Resources"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}"
             AllowDrop="True"
             DragOver="Page_DragOver"
             Drop="Page_Drop"
             AutomationProperties.Name="{x:Static res:Strings.Converter_PageTitle}">
    <ScrollViewer Style="{DynamicResource WlScrollViewer}">
        <Grid MaxWidth="720" HorizontalAlignment="Left" Margin="44,38,44,60">
            <StackPanel>
                <!-- ═══ Heading ═════════════════════════════════════════════ -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource WlMonoNumber}" Text="10" Margin="0,0,14,0" />
                    <TextBlock Style="{DynamicResource WlPageTitle}" Text="{x:Static res:Strings.Converter_PageTitle}" />
                </StackPanel>
                <TextBlock Style="{DynamicResource WlPageSubtitle}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="{x:Static res:Strings.Converter_Subtitle}" />

                <Border Style="{DynamicResource WlHairline}" Margin="0,26,0,26" />

                <!-- ═══ Input ═══════════════════════════════════════════════ -->
                <TextBlock Style="{DynamicResource WlSectionLabel}"
                           controls:Type.Tracked="{x:Static res:Strings.Converter_SourceSection}" />

                <Border Style="{DynamicResource WlInsetPanel}" Padding="16,14" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="InputNameText"
                                       Style="{DynamicResource WlBody}"
                                       Text="{x:Static res:Strings.Converter_NoFile}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="InputDetailText"
                                       Style="{DynamicResource WlCaption}"
                                       Foreground="{DynamicResource WlTextMuted}"
                                       Text="{x:Static res:Strings.Converter_DragHint}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="{x:Static res:Strings.Converter_Choose}"
                                Style="{DynamicResource WlSecondaryButton}"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Click="ChooseInput_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Converter_ChooseInputAutomation}" />
                    </Grid>
                </Border>

                <!-- ═══ Target ══════════════════════════════════════════════ -->
                <TextBlock Style="{DynamicResource WlSectionLabel}"
                           controls:Type.Tracked="{x:Static res:Strings.Converter_ConvertTo}"
                           Margin="0,24,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ComboBox x:Name="TargetBox"
                              Style="{DynamicResource WlComboBox}"
                              Width="180"
                              SelectionChanged="Target_Changed"
                              AutomationProperties.Name="{x:Static res:Strings.Converter_TargetFormatAutomation}" />
                    <TextBlock x:Name="TargetNoteText"
                               Style="{DynamicResource WlCaption}"
                               Foreground="{DynamicResource WlTextMuted}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="440"
                               Margin="14,0,0,0" />
                </StackPanel>

                <!-- ═══ Output ══════════════════════════════════════════════ -->
                <TextBlock Style="{DynamicResource WlSectionLabel}"
                           controls:Type.Tracked="{x:Static res:Strings.Converter_SaveAs}"
                           Margin="0,24,0,0" />

                <Border Style="{DynamicResource WlInsetPanel}" Padding="16,14" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="OutputPathText"
                                   Style="{DynamicResource WlSecondary}"
                                   Text="—"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <Button Grid.Column="1"
                                Content="{x:Static res:Strings.Converter_Change}"
                                Style="{DynamicResource WlTextButton}"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Click="ChooseOutput_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Converter_ChangeOutputAutomation}" />
                    </Grid>
                </Border>

                <!-- ═══ Action ══════════════════════════════════════════════ -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button x:Name="ConvertButton"
                            Content="{x:Static res:Strings.Converter_Convert}"
                            Style="{DynamicResource WlPrimaryButton}"
                            MinHeight="34"
                            Padding="20,0"
                            IsEnabled="False"
                            Click="Convert_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Converter_ConvertAutomation}" />
                    <Button x:Name="CancelButton"
                            Content="{x:Static res:Strings.Converter_Cancel}"
                            Style="{DynamicResource WlTextButton}"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="Cancel_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Converter_CancelAutomation}" />
                </StackPanel>

                <!-- Real progress. Determinate when the work is countable, and
                     indeterminate rather than invented when it is not. -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,18,0,0">
                    <TextBlock x:Name="ProgressStageText"
                               Style="{DynamicResource WlMonoLabel}"
                               Foreground="{DynamicResource WlBrand}" />
                    <ProgressBar x:Name="ProgressIndicator"
                                 Height="3"
                                 Margin="0,10,0,0"
                                 Background="{DynamicResource WlRaised}"
                                 Foreground="{DynamicResource WlBrand}"
                                 BorderThickness="0" />
                </StackPanel>

                <!-- ═══ Result ══════════════════════════════════════════════ -->
                <Border x:Name="ResultPanel"
                        Style="{DynamicResource WlResultCard}"
                        Margin="0,20,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource WlIconSm}"
                                  Data="{DynamicResource WlIconCheck}"
                                  Stroke="{DynamicResource WlSuccess}"
                                  VerticalAlignment="Center" />
                            <TextBlock x:Name="ResultTitleText"
                                       Style="{DynamicResource WlCardTitle}"
                                       Text="{x:Static res:Strings.Converter_ResultTitle}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="ResultDetailText"
                                   Style="{DynamicResource WlCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />

                        <TextBlock x:Name="ResultWarningsText"
                                   Style="{DynamicResource WlCaption}"
                                   Foreground="{DynamicResource WlWarning}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{x:Static res:Strings.Converter_OpenFile}" Style="{DynamicResource WlSecondaryButton}"
                                    Click="OpenResult_Click" />
                            <Button Content="{x:Static res:Strings.Converter_OpenFolder}" Style="{DynamicResource WlTextButton}"
                                    Margin="6,0,0,0" Click="OpenFolder_Click" />
                            <Button Content="{x:Static res:Strings.Converter_OpenInEditor}" Style="{DynamicResource WlTextButton}"
                                    Margin="6,0,0,0" Click="OpenInEditor_Click" />
                            <Button Content="{x:Static res:Strings.Converter_ConvertAgain}" Style="{DynamicResource WlTextButton}"
                                    Margin="6,0,0,0" Click="ConvertAnother_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorPanel"
                        Style="{DynamicResource WlInsetPanel}"
                        BorderBrush="{DynamicResource WlWarningBorder}"
                        Background="{DynamicResource WlWarningSoft}"
                        Padding="16,14"
                        Margin="0,20,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               Style="{DynamicResource WlCaption}"
                               Foreground="{DynamicResource WlWarning}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- ═══ Matrix ══════════════════════════════════════════════ -->
                <Border Style="{DynamicResource WlHairline}" Margin="0,34,0,26" />

                <TextBlock Style="{DynamicResource WlSectionLabel}"
                           controls:Type.Tracked="{x:Static res:Strings.Converter_WhatIsConverted}" />

                <TextBlock Style="{DynamicResource WlCaption}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="{x:Static res:Strings.Converter_ConversionMatrixNote}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

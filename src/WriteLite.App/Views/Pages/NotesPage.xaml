<UserControl x:Class="WriteLite.Views.Pages.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WriteLite.Controls"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}"
             AutomationProperties.Name="Заметки">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header and toolbar are Auto so they shrink with the window; only the
                 board takes the slack. Nothing on this page has a fixed height, which
                 is what keeps the last row of cards reachable at 1280 × 720. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ══════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="36,32,36,0">
            <TextBlock Style="{DynamicResource WlMonoLabel}"
                       controls:Type.Tracked="ЗАМЕТКИ"
                       Foreground="{DynamicResource WlBrand}" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{DynamicResource WlPageTitle}" Text="Личное пространство" />
                    <TextBlock Style="{DynamicResource WlPageSubtitle}"
                               Text="Заметки, задачи, цели и списки. Всё хранится на этом компьютере."
                               MaxWidth="560"
                               HorizontalAlignment="Left"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Button x:Name="NewNoteButton"
                        Grid.Column="1"
                        Style="{DynamicResource WlPrimaryButton}"
                        VerticalAlignment="Top"
                        Margin="20,2,0,0"
                        Click="NewNote_Click"
                        AutomationProperties.Name="Создать новую заметку">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{DynamicResource WlIconSm}"
                              Data="{DynamicResource WlIconPlus}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Новая заметка" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ═══ Filters, search, sort ═══════════════════════════════════════ -->
        <Border Grid.Row="1" Margin="36,22,36,0"
                BorderBrush="{DynamicResource WlLine}"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,2">
            <!-- A WrapPanel, not a Grid: at a narrow window the sort control drops to a
                 second line instead of squeezing the tabs off the page. -->
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,24,0">
                    <RadioButton x:Name="TabAll" Style="{DynamicResource WlTabButton}"
                                 Content="Все" GroupName="NotesFilter" IsChecked="True"
                                 Checked="Filter_Changed" />
                    <RadioButton x:Name="TabTasks" Style="{DynamicResource WlTabButton}"
                                 Content="Задачи" GroupName="NotesFilter"
                                 Checked="Filter_Changed" />
                    <RadioButton x:Name="TabGoals" Style="{DynamicResource WlTabButton}"
                                 Content="Цели" GroupName="NotesFilter"
                                 Checked="Filter_Changed" />
                    <RadioButton x:Name="TabCompleted" Style="{DynamicResource WlTabButton}"
                                 Content="Выполненные" GroupName="NotesFilter"
                                 Checked="Filter_Changed" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox"
                             Style="{DynamicResource WlSearchInput}"
                             Width="230"
                             MinWidth="150"
                             Tag="Поиск по заметкам"
                             TextChanged="Search_Changed"
                             AutomationProperties.Name="Поиск по заметкам" />

                    <ComboBox x:Name="SortBox"
                              Style="{DynamicResource WlComboBox}"
                              Width="176"
                              Margin="10,0,0,0"
                              SelectedIndex="0"
                              SelectionChanged="Sort_Changed"
                              AutomationProperties.Name="Порядок заметок">
                        <ComboBoxItem Content="Сначала изменённые" />
                        <ComboBoxItem Content="Сначала новые" />
                        <ComboBoxItem Content="По сроку" />
                        <ComboBoxItem Content="По названию" />
                        <ComboBoxItem Content="Мой порядок" />
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ═══ Board ═══════════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="BoardScroll" Grid.Row="2" Style="{DynamicResource WlScrollViewer}"
                      Margin="0,18,0,0" Padding="36,0,22,0">
            <Grid>
                <controls:NoteBoard x:Name="Board" />

                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Left"
                            Margin="0,26,0,0"
                            MaxWidth="440"
                            Visibility="Collapsed">
                    <TextBlock x:Name="EmptyTitle"
                               Style="{DynamicResource WlSectionTitle}"
                               Text="Пока пусто" />
                    <TextBlock x:Name="EmptyHint"
                               Style="{DynamicResource WlSecondary}"
                               Text="Создайте первую заметку, задачу или цель — всё останется на этом компьютере."
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══ Status ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource WlBg}"
                BorderBrush="{DynamicResource WlLine}"
                BorderThickness="0,1,0,0"
                Padding="36,0">
            <Grid Height="30">
                <TextBlock x:Name="StatusText"
                           Style="{DynamicResource WlMonoLabel}"
                           Foreground="{DynamicResource WlTextMuted}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="StorageText"
                           Style="{DynamicResource WlMonoLabel}"
                           Foreground="{DynamicResource WlTextMuted}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           controls:Type.Tracked="ЛОКАЛЬНОЕ ХРАНИЛИЩЕ" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

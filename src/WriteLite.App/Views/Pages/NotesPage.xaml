<UserControl x:Class="WriteLite.Views.Pages.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notes="clr-namespace:WriteLite.Views.Notes"
             xmlns:res="clr-namespace:WriteLite.Resources"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}"
             Focusable="True"
             PreviewKeyDown="Page_PreviewKeyDown">
    <!--
        Three panes, the way Apple Notes lays them out: folders, the notes in the folder grouped
        by when they were last touched, and the open note — so moving between notes is one click
        and nothing ever navigates away. «Календарь» replaces the list and the note with a month.
    -->
    <UserControl.Resources>
        <Style x:Key="FolderItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource WlTextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WlHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource WlText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WlBrandSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource WlText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FolderColumn" Width="224" />
            <ColumnDefinition x:Name="ListColumn" Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Folders ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource WlBg}"
                BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,12">
                <TextBlock DockPanel.Dock="Top" Style="{DynamicResource WlMonoLabel}" Text="ЗАМЕТКИ" Margin="10,0,0,10" />
                <StackPanel DockPanel.Dock="Top" x:Name="SmartFolders" />

                <Grid DockPanel.Dock="Top" Margin="10,20,0,6">
                    <TextBlock Style="{DynamicResource WlMonoLabel}" Text="ПАПКИ" VerticalAlignment="Center" />
                    <Button x:Name="AddFolderButton" HorizontalAlignment="Right" Style="{DynamicResource WlIconButton}"
                            Width="24" Height="24" Click="AddFolder_Click" ToolTip="Новая папка"
                            AutomationProperties.Name="Новая папка">
                        <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconPlus}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Top" x:Name="NewFolderRow" Visibility="Collapsed" Margin="0,0,0,6">
                    <TextBox x:Name="NewFolderBox" Style="{DynamicResource WlSmallInput}" Tag="Название папки"
                             KeyDown="NewFolderBox_KeyDown" LostFocus="NewFolderBox_LostFocus" />
                </Border>

                <RadioButton DockPanel.Dock="Bottom" x:Name="TrashFolder" GroupName="NotesFolders"
                             Style="{StaticResource FolderItem}" Checked="Folder_Checked" Tag="trash"
                             AutomationProperties.Name="Недавно удалённые">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconTrash}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Недавно удалённые" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TrashCount" HorizontalAlignment="Right" Style="{DynamicResource WlMonoLabel}" />
                    </Grid>
                </RadioButton>

                <ScrollViewer Style="{DynamicResource WlScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FolderList" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ Note list ═════════════════════════════════════════════════════ -->
        <Border x:Name="ListPane" Grid.Column="1" Background="{DynamicResource WlBgBase}"
                BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="18,18,12,0">
                    <StackPanel>
                        <TextBlock x:Name="FolderTitle" Text="Все заметки" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WlText}" TextTrimming="CharacterEllipsis" Margin="0,0,64,0" />
                        <TextBlock x:Name="StatusText" Style="{DynamicResource WlCaption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="SortButton" Style="{DynamicResource WlIconButton}" Width="30" Height="30"
                                Click="Sort_Click" ToolTip="Сортировка" AutomationProperties.Name="Сортировка">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconFilter}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="NewNoteButton" Style="{DynamicResource WlIconButton}" Width="30" Height="30"
                                Click="NewNote_Click" ToolTip="Новая заметка (Ctrl+N)"
                                AutomationProperties.Name="Новая заметка">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconNewDocument}"
                                  Stroke="{DynamicResource WlBrand}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Style="{DynamicResource WlSearchInput}"
                         Margin="14,12,12,8" Tag="Поиск по заметкам"
                         TextChanged="Search_Changed" AutomationProperties.Name="Поиск по заметкам" />

                <Border DockPanel.Dock="Bottom" x:Name="TrashBar" Visibility="Collapsed" Padding="14,10"
                        BorderBrush="{DynamicResource WlLine}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource WlTextButton}" Content="Очистить"
                                Click="EmptyTrash_Click" />
                        <TextBlock Style="{DynamicResource WlCaption}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Заметки удаляются навсегда через 30 дней." />
                    </DockPanel>
                </Border>

                <Grid>
                    <ScrollViewer x:Name="ListScroll" Style="{DynamicResource WlScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NoteList" Margin="8,0,6,16" />
                    </ScrollViewer>
                    <StackPanel x:Name="ListEmpty" Visibility="Collapsed" VerticalAlignment="Center" Margin="24,0">
                        <TextBlock x:Name="ListEmptyTitle" Text="Нет заметок" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WlText}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ListEmptyHint" Style="{DynamicResource WlCaption}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,6,0,0" HorizontalAlignment="Center"
                                   Text="Нажмите Ctrl+N, чтобы создать заметку." />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══ Open note ═════════════════════════════════════════════════════ -->
        <Grid x:Name="DetailPane" Grid.Column="2">
            <notes:NoteEditorView x:Name="EditorView" Visibility="Collapsed" />
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <Path Style="{DynamicResource WlIconLg}" Data="{DynamicResource WlIconNotes}"
                      Stroke="{DynamicResource WlTextMuted}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" Text="Выберите заметку" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource WlText}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Style="{DynamicResource WlCaption}" HorizontalAlignment="Center" Margin="0,6,0,14"
                           Text="…или начните новую — в ней можно писать, рисовать и вести списки." />
                <Button Style="{DynamicResource WlPrimaryButton}" Content="Новая заметка" HorizontalAlignment="Center"
                        Padding="18,0" MinHeight="32" Click="NewNote_Click" />
            </StackPanel>
        </Grid>

        <!-- ═══ Calendar (spans the list and the note) ══════════════════════ -->
        <notes:NotesCalendarView x:Name="CalendarView" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" />
    </Grid>
</UserControl>

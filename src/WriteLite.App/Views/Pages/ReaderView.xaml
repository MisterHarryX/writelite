<UserControl x:Class="WriteLite.Views.Pages.ReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WriteLite.Controls"
             xmlns:res="clr-namespace:WriteLite.Resources"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}"
             SizeChanged="Reader_SizeChanged"
             AutomationProperties.Name="{x:Static res:Strings.Nav_Reading}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Document bar ════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource WlBgBase}"
                BorderBrush="{DynamicResource WlLine}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0,14,0" MinHeight="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Style="{DynamicResource WlToolbarButton}"
                        Content="{x:Static res:Strings.Reader_Back}"
                        Click="Back_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Reader_BackAutomation}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Style="{DynamicResource WlCardTitle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Border Style="{DynamicResource WlToolbarRule}" Margin="12,0" />
                    <TextBlock x:Name="LocationText"
                               Style="{DynamicResource WlMonoLabel}"
                               Foreground="{DynamicResource WlTextMuted}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressText"
                               Style="{DynamicResource WlMonoLabel}"
                               Foreground="{DynamicResource WlTextSubtle}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Border Width="72" VerticalAlignment="Center">
                        <Grid>
                            <Border Style="{DynamicResource WlProgressTrack}" />
                            <Border x:Name="ProgressFill" Style="{DynamicResource WlProgressFill}" Width="0" />
                        </Grid>
                    </Border>
                    <ToggleButton x:Name="PanelToggle"
                                  Style="{DynamicResource WlFormatToggle}"
                                  Margin="12,0,0,0"
                                  IsChecked="True"
                                  Checked="PanelToggle_Changed"
                                  Unchecked="PanelToggle_Changed"
                                   ToolTip="{x:Static res:Strings.Reader_TogglePanelTooltip}"
                                   AutomationProperties.Name="{x:Static res:Strings.Reader_TogglePanelAutomation}">
                        <Path Style="{DynamicResource WlIconSm}"
                              Data="{DynamicResource WlIconPanel}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Reader toolbar ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource WlBg}"
                BorderBrush="{DynamicResource WlLine}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Padding="14,0" MinHeight="40">
                <!-- Horizontally scrollable rather than wrapping: the reader toolbar is
                     one row of related controls, and letting it reflow into two rows
                     would push the reading canvas down every time the window narrows. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Page navigation leads the toolbar because it is the only group here
                         that answers "where am I", and because this row scrolls horizontally:
                         anything placed after the typography controls would be the first
                         thing to leave the screen on a narrow window. -->
                    <Button x:Name="PreviousPageButton" Style="{DynamicResource WlIconButton}"
                            Width="28" Height="28" Content="‹"
                            Click="PreviousPage_Click" ToolTip="{x:Static res:Strings.Reader_PreviousPageTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.Reader_PreviousPageAutomation}" />
                    <TextBox x:Name="PageBox" Style="{DynamicResource WlSmallInput}"
                             Width="46" Margin="6,0,0,0" VerticalAlignment="Center"
                             TextAlignment="Center"
                             KeyDown="PageBox_KeyDown"
                             LostFocus="PageBox_LostFocus"
                             ToolTip="{x:Static res:Strings.Reader_PageInputTooltip}"
                             AutomationProperties.Name="{x:Static res:Strings.Reader_PageInputAutomation}" />
                    <TextBlock x:Name="PageCountText" Style="{DynamicResource WlMonoValue}"
                               Foreground="{DynamicResource WlTextMuted}"
                               VerticalAlignment="Center" Margin="6,0,6,0" />
                    <Button x:Name="NextPageButton" Style="{DynamicResource WlIconButton}"
                            Width="28" Height="28" Content="›"
                            Click="NextPage_Click" ToolTip="{x:Static res:Strings.Reader_NextPageTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.Reader_NextPageAutomation}" />

                    <Border Style="{DynamicResource WlToolbarRule}" Margin="10,0" />

                    <Button x:Name="HighlightButton" Style="{DynamicResource WlToolbarButton}"
                            Click="Highlight_Click" ToolTip="{x:Static res:Strings.Reader_HighlightTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.Reader_Highlight}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconHighlight}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.Reader_Highlight}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="AnnotateButton" Style="{DynamicResource WlToolbarButton}"
                            Click="Annotate_Click" ToolTip="{x:Static res:Strings.Reader_AnnotateTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.Reader_AddAnnotation}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconAnnotation}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.Reader_Annotate}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CardButton" Style="{DynamicResource WlToolbarButton}"
                            Click="Card_Click" ToolTip="{x:Static res:Strings.Reader_CreateCardTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.Reader_CreateCard}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconCards}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.Reader_Card}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BookmarkButton" Style="{DynamicResource WlToolbarButton}"
                            Click="Bookmark_Click" ToolTip="{x:Static res:Strings.Reader_AddBookmarkTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.Reader_AddBookmark}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconBookmark}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.Reader_Bookmark}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Style="{DynamicResource WlToolbarRule}" Margin="10,0" />

                    <TextBlock Style="{DynamicResource WlMonoLabel}"
                               controls:Type.Tracked="{x:Static res:Strings.Reader_FontSizeLabel}"
                               Foreground="{DynamicResource WlTextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="FontSmallerButton" Style="{DynamicResource WlIconButton}" Width="28" Height="28"
                            Content="−" Click="FontSmaller_Click" ToolTip="{x:Static res:Strings.Reader_FontSmaller}"
                            AutomationProperties.Name="{x:Static res:Strings.Reader_FontSmaller}" />
                    <TextBlock x:Name="FontSizeText" Style="{DynamicResource WlMonoValue}"
                               Width="30" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Name="FontLargerButton" Style="{DynamicResource WlIconButton}" Width="28" Height="28"
                            Content="+" Click="FontLarger_Click" ToolTip="{x:Static res:Strings.Reader_FontLarger}"
                            AutomationProperties.Name="{x:Static res:Strings.Reader_FontLarger}" />

                    <Border Style="{DynamicResource WlToolbarRule}" Margin="10,0" />

                    <TextBlock Style="{DynamicResource WlMonoLabel}"
                               controls:Type.Tracked="{x:Static res:Strings.Reader_LineSpacingLabel}"
                               Foreground="{DynamicResource WlTextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="SpacingSlider" Style="{DynamicResource WlSlider}"
                            Width="90" Minimum="1.2" Maximum="2.6" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="Spacing_Changed"
                            AutomationProperties.Name="{x:Static res:Strings.Reader_LineSpacingAutomation}" />

                    <Border Style="{DynamicResource WlToolbarRule}" Margin="10,0" />

                    <TextBlock Style="{DynamicResource WlMonoLabel}"
                               controls:Type.Tracked="{x:Static res:Strings.Reader_WidthLabel}"
                               Foreground="{DynamicResource WlTextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="WidthSlider" Style="{DynamicResource WlSlider}"
                            Width="90" Minimum="480" Maximum="1400" TickFrequency="20"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="Width_Changed"
                            AutomationProperties.Name="{x:Static res:Strings.Reader_WidthAutomation}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ Canvas and marks ════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- The text column keeps a floor and the panel gives way above it. A fixed
                 340 px sidebar against a bare star column let the reading canvas be
                 squeezed to nothing as the window narrowed, which is how the book
                 disappeared while the panel stayed. MaxWidth on the panel means it
                 stops growing rather than the text stopping shrinking. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="PanelColumn" Width="340" MinWidth="0" MaxWidth="340" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="CanvasScroll"
                          Grid.Column="0"
                          Style="{DynamicResource WlScrollViewer}"
                          Padding="0"
                          ScrollChanged="Canvas_ScrollChanged">
                <Grid>
                    <RichTextBox x:Name="Canvas"
                                 Style="{DynamicResource WlReadingCanvas}"
                                 Margin="48,40,48,80"
                                 MaxWidth="720"
                                 HorizontalAlignment="Center"
                                 ContextMenuOpening="Canvas_ContextMenuOpening"
                                 MouseDoubleClick="Canvas_MouseDoubleClick"
                                 AutomationProperties.Name="{x:Static res:Strings.Reader_BookTextAutomation}" />

                    <StackPanel x:Name="LoadingState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,90,0,0"
                                Visibility="Collapsed">
                        <TextBlock Style="{DynamicResource WlMonoLabel}"
                                   controls:Type.Tracked="{x:Static res:Strings.Reader_OpeningBook}"
                                   Foreground="{DynamicResource WlTextMuted}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="LoadingHint"
                                   Style="{DynamicResource WlCaption}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="ErrorState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                MaxWidth="440"
                                Margin="0,90,0,0"
                                Visibility="Collapsed">
                        <TextBlock x:Name="ErrorTitle" Style="{DynamicResource WlSectionTitle}" />
                        <TextBlock x:Name="ErrorHint" Style="{DynamicResource WlSecondary}" Margin="0,8,0,0" />
                        <Button x:Name="RelocateButton"
                                Style="{DynamicResource WlSecondaryButton}"
                                Content="{x:Static res:Strings.Reader_RelocateButton}"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Click="Relocate_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Marks panel ────────────────────────────────────────────── -->
            <Border x:Name="Panel"
                    Grid.Column="1"
                    Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="1,0,0,0">
                <Grid Margin="18,16,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="TabAnnotations" Style="{DynamicResource WlTabButton}"
                                     Content="{x:Static res:Strings.Reader_TabAnnotations}" GroupName="ReaderPanel" IsChecked="True"
                                     Checked="PanelTab_Changed" />
                        <RadioButton x:Name="TabBookmarks" Style="{DynamicResource WlTabButton}"
                                     Content="{x:Static res:Strings.Reader_TabBookmarks}" GroupName="ReaderPanel"
                                     Checked="PanelTab_Changed" />
                        <RadioButton x:Name="TabCards" Style="{DynamicResource WlTabButton}"
                                     Content="{x:Static res:Strings.Reader_TabCards}" GroupName="ReaderPanel"
                                     Checked="PanelTab_Changed" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Style="{DynamicResource WlScrollViewer}" Padding="0,0,8,0">
                        <StackPanel>
                            <StackPanel x:Name="MarksList" />
                            <StackPanel x:Name="PanelEmpty" Margin="0,20,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="PanelEmptyTitle" Style="{DynamicResource WlCardTitle}" />
                                <TextBlock x:Name="PanelEmptyHint" Style="{DynamicResource WlSecondary}" Margin="0,7,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Status ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource WlBg}"
                BorderBrush="{DynamicResource WlLine}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid Height="30">
                <TextBlock x:Name="SummaryText"
                           Style="{DynamicResource WlMonoLabel}"
                           Foreground="{DynamicResource WlTextMuted}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HintText"
                           Style="{DynamicResource WlMonoLabel}"
                           Foreground="{DynamicResource WlTextMuted}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           controls:Type.Tracked="{x:Static res:Strings.Reader_Hint}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="WriteLite.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WriteLite.Controls"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}">
    <!--
        Settings follow the website's numbered structure. Rows and separators, not a
        stack of cards, and every row explains what it changes — the point is that a
        writer can decide without guessing.
    -->
    <ScrollViewer Style="{DynamicResource WlScrollViewer}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="36,30,36,48">

            <!-- ═══ 01 Общие ════════════════════════════════════════════════ -->
            <controls:SectionHeader Index="01" Title="Общие"
                                    Description="Поведение WriteLite при запуске и в системном трее." />
            <StackPanel Margin="0,4,0,0">
                <controls:SettingRow Label="Проверка текста"
                                     Description="Полностью включает или выключает анализ активных полей.">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkChecking" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Проверка текста включена"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Индикатор рядом с полем"
                                     Description="Плавающая метка с числом замечаний возле активного поля.">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkIndicator" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Показывать индикатор"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow x:Name="RowAutostart" Label="Запуск вместе с Windows">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkAutostart" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Запускать вместе с Windows"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Открывать главное окно при запуске"
                                     Description="Иначе WriteLite стартует свёрнутым в трей.">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkOpenMain" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Открывать главное окно при запуске"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Сворачивать в трей при закрытии"
                                     Description="Закрытие окна не завершает проверку в других приложениях.">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkTrayClose" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Сворачивать в трей при закрытии"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>
            </StackPanel>

            <!-- ═══ 02 Проверка ═════════════════════════════════════════════ -->
            <controls:SectionHeader Index="02" Title="Проверка"
                                    Description="Какие типы замечаний WriteLite показывает."
                                    Margin="0,40,0,0" />
            <StackPanel Margin="0,4,0,0">
                <controls:SettingRow Label="Расширенная проверка"
                                     Description="Дополнительный языковой движок поверх быстрых правил.">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkExtended" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Расширенная проверка"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Орфография">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkOrtho" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Орфография"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Пунктуация">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkPunct" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Пунктуация"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Грамматика">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkGrammar" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Грамматика"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Стиль">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkStyle" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Стиль"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Типографика"
                                     Description="Кавычки, тире и пробелы вокруг знаков.">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkTypo" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Типографика"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Повторы">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkRepeats" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Повторы"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Исправлять все безопасные замечания"
                                     Description="Кнопка «Исправить все» применяет только уверенные правки.">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkSafeAll" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Безопасное исправление всех замечаний"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>
            </StackPanel>

            <!-- ═══ 03 Языки ════════════════════════════════════════════════ -->
            <controls:SectionHeader Index="03" Title="Языки"
                                    Description="Русская проверка доступна в beta; английская в разработке."
                                    Margin="0,40,0,0" />
            <StackPanel Margin="0,4,0,0">
                <controls:SettingRow Label="Язык проверки"
                                     Description="Смешанный RU/EN текст определяется автоматически.">
                    <controls:SettingRow.Control>
                        <TextBlock Text="Русский" Style="{DynamicResource WlMonoValue}"
                                   Foreground="{DynamicResource WlText}" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>
            </StackPanel>

            <!-- ═══ 04 Поведение интерфейса ═════════════════════════════════ -->
            <controls:SectionHeader Index="04" Title="Интерфейс"
                                    Description="Когда WriteLite появляется и как ведут себя подчёркивания."
                                    Margin="0,40,0,0" />
            <StackPanel Margin="0,4,0,0">
                <controls:SettingRow Label="Задержка анализа"
                                     Description="Пауза после ввода перед проверкой, в миллисекундах.">
                    <controls:SettingRow.Control>
                        <TextBox x:Name="TxtDelay" Style="{DynamicResource WlSmallInput}"
                                 AutomationProperties.Name="Задержка анализа в миллисекундах"
                                 LostFocus="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Максимальная длина текста"
                                     Description="Более длинный текст проверяется частями.">
                    <controls:SettingRow.Control>
                        <TextBox x:Name="TxtMaxLen" Style="{DynamicResource WlSmallInput}"
                                 AutomationProperties.Name="Максимальная длина текста"
                                 LostFocus="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Пауза до скрытия интерфейса"
                                     Description="Секунды бездействия, 2–30.">
                    <controls:SettingRow.Control>
                        <TextBox x:Name="TxtIdleGrace" Style="{DynamicResource WlSmallInput}" Width="72"
                                 AutomationProperties.Name="Пауза до скрытия интерфейса в секундах"
                                 LostFocus="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Показывать индикатор без ошибок"
                                     Description="Спокойная отметка, когда замечаний нет.">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkGreen" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Показывать индикатор без ошибок"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Скрывать панель после исправления">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkHidePanel" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Скрывать панель после успешного исправления"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Показывать интерфейс только во время ввода">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkOnlyEditing" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Показывать интерфейс только во время ввода"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Словарная карточка по двойному щелчку"
                                     Description="Формы, синонимы и толкование прямо в поле ввода.">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkLexical" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Словарная карточка по двойному щелчку"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Минимизировать дублирование подчёркиваний"
                                     Description="Делает линии WriteLite тоньше рядом с системной проверкой.">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkMinimizeDup" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Минимизировать дублирование с системной проверкой"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>
            </StackPanel>

            <Border Style="{DynamicResource WlCard}" Margin="0,20,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Style="{DynamicResource WlCardTitle}" Text="Системная проверка орфографии" />
                    <TextBlock Style="{DynamicResource WlSecondary}" Margin="0,7,0,10"
                               Text="WriteLite не отключает встроенную проверку Windows и браузеров: это небезопасно и не универсально. Чтобы убрать двойные волны, отключите проверку в самом приложении:" />
                    <TextBlock Style="{DynamicResource WlCaption}" Margin="0,0,0,5"
                               Text="Edge / Chrome — Параметры → Языки → Проверка правописания." />
                    <TextBlock Style="{DynamicResource WlCaption}" Margin="0,0,0,5"
                               Text="Word — Файл → Параметры → Правописание → «Проверять орфографию в процессе набора»." />
                    <TextBlock Style="{DynamicResource WlCaption}" Margin="0,0,0,5"
                               Text="Блокнот (Windows 11) — Параметры → Правописание." />
                    <TextBlock Style="{DynamicResource WlCaption}"
                               Text="Outlook — Файл → Параметры → Почта → Орфография и автозамена." />
                </StackPanel>
            </Border>

            <!-- ═══ 05 WriteAI ══════════════════════════════════════════════ -->
            <controls:SectionHeader Index="05" Title="WriteAI"
                                    Description="Умные действия на этом компьютере. Текст не покидает ваш компьютер."
                                    Margin="0,40,0,0" />
            <StackPanel Margin="0,4,0,0">
                <controls:SettingRow Label="WriteAI">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkLocalAi" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Включить WriteAI"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Использовать WriteAI, если сервер доступен">
                    <controls:SettingRow.Control>
                        <CheckBox x:Name="ChkPreferQwen" Style="{DynamicResource WlToggleSwitch}"
                                  AutomationProperties.Name="Использовать WriteAI"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Профиль"
                                     Description="Lite не требует Python и сети; Quality сильнее нагружает CPU.">
                    <controls:SettingRow.Control>
                        <ComboBox x:Name="CmbLocalAiProfile" Style="{DynamicResource WlComboBox}"
                                  Width="150"
                                  AutomationProperties.Name="Профиль WriteAI"
                                  SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Lite" />
                            <ComboBoxItem Content="Standard" />
                            <ComboBoxItem Content="Quality" />
                            <ComboBoxItem Content="Auto" />
                        </ComboBox>
                    </controls:SettingRow.Control>
                </controls:SettingRow>

                <controls:SettingRow Label="Адрес сервера WriteAI"
                                     Description="Локальный адрес, по которому работает WriteAI.">
                    <controls:SettingRow.Control>
                        <TextBox x:Name="TxtQwenEndpoint" Style="{DynamicResource WlTextInput}"
                                 Width="240"
                                 FontFamily="{DynamicResource WlFontMono}"
                                 FontSize="12"
                                 Tag="http://127.0.0.1:8742"
                                 AutomationProperties.Name="Адрес сервера WriteAI"
                                 LostFocus="Setting_Changed" />
                    </controls:SettingRow.Control>
                </controls:SettingRow>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{DynamicResource WlSecondaryButton}" Content="Проверить подключение" Click="ProbeWriteAi_Click" />
            </StackPanel>
            <TextBlock x:Name="LocalAiStatusHint" Style="{DynamicResource WlCaption}" Margin="0,10,0,0" />

            <!-- ═══ 06 Приватность ══════════════════════════════════════════ -->
            <controls:SectionHeader Index="06" Title="Сочетания клавиш"
                                    Description="Щёлкните по сочетанию и нажмите новые клавиши. Escape — отмена."
                                    Margin="0,40,0,0" />

            <StackPanel x:Name="ShortcutList" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{DynamicResource WlSecondaryButton}"
                        Content="Сбросить все сочетания"
                        Click="ResetShortcuts_Click"
                        AutomationProperties.Name="Сбросить все сочетания клавиш" />
            </StackPanel>
            <TextBlock x:Name="ShortcutHint" Style="{DynamicResource WlCaption}" Margin="0,10,0,0" TextWrapping="Wrap" />

            <controls:SectionHeader Index="07" Title="Приватность" Margin="0,40,0,0" />
            <TextBlock Style="{DynamicResource WlBody}"
                       Foreground="{DynamicResource WlTextSecondary}"
                       LineHeight="23"
                       Margin="0,18,0,0"
                       Text="Проверка текста выполняется локально. WriteLite не отправляет текст во внешние ИИ-сервисы. Сведения о сторонних компонентах — в файле THIRD_PARTY_NOTICES." />
        </StackPanel>
    </ScrollViewer>
</UserControl>

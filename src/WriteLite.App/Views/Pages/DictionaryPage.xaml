<UserControl x:Class="WriteLite.Views.Pages.DictionaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WriteLite.Controls"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}">
    <!--
        The dictionary is a reading surface, not a settings screen: the article is
        set in the prose scale with a large lemma, sense-numbered definitions and
        generous leading, closer to a printed entry than to a dashboard.

        Two things make it a workspace rather than a lookup box. Synonyms, antonyms
        and translations are chips that open their own article, so a reader can walk
        the vocabulary the way they would follow links; and back / forward keep the
        trail, because a walk you cannot retrace is a walk you stop taking.

        The search field and its controls are pinned above the scrolling article.
        Chasing the search box down the page after every lookup is the fastest way
        to make a dictionary feel like a form.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Search header ═══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="36,30,36,0" MaxWidth="880" HorizontalAlignment="Left">
            <controls:SectionHeader Index="03"
                                    Title="Словарь"
                                    Description="Значения, формы, синонимы, антонимы и перевод — из установленных словарей, без интернета."
                                    ShowRule="False" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Back / forward. Two quiet icon buttons, disabled when there is
                     nowhere to go, exactly as a browser would show them. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button x:Name="BackButton"
                            Style="{DynamicResource WlIconButton}"
                            Height="34" Width="30"
                            IsEnabled="False"
                            ToolTip="Назад"
                            Click="Back_Click"
                            AutomationProperties.Name="Назад по истории слов">
                        <Path Style="{DynamicResource WlIconSm}"
                              Data="{DynamicResource WlIconChevronRight}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button x:Name="ForwardButton"
                            Style="{DynamicResource WlIconButton}"
                            Height="34" Width="30"
                            IsEnabled="False"
                            ToolTip="Вперёд"
                            Click="Forward_Click"
                            AutomationProperties.Name="Вперёд по истории слов">
                        <Path Style="{DynamicResource WlIconSm}"
                              Data="{DynamicResource WlIconChevronRight}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Style="{DynamicResource WlSearchInput}"
                         MinHeight="40"
                         FontSize="14"
                         Tag="Введите слово — русское или английское"
                         KeyDown="SearchBox_KeyDown"
                         AutomationProperties.Name="Поиск слова в словаре" />
            </Grid>

            <!-- The trail so far. One line, no panel: history is context, not a feature. -->
            <TextBlock x:Name="TrailText"
                       Style="{DynamicResource WlCaption}"
                       Foreground="{DynamicResource WlTextMuted}"
                       Margin="0,10,0,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- ═══ Article ═════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" x:Name="ArticleScroll" Style="{DynamicResource WlScrollViewer}">
            <Grid Margin="36,0,36,44" MaxWidth="880" HorizontalAlignment="Left">

                <StackPanel x:Name="Article" Visibility="Collapsed" Margin="0,28,0,0">
                    <TextBlock x:Name="WordText" Style="{DynamicResource WlWordTitle}" Text="—" />

                    <!-- Grammatical line: lemma, part of speech, language. -->
                    <StackPanel x:Name="GrammarLine" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="PartOfSpeechText" Style="{DynamicResource WlSecondary}"
                                   Foreground="{DynamicResource WlBrand}"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="LemmaText" Style="{DynamicResource WlMonoValue}"
                                   Foreground="{DynamicResource WlTextSubtle}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="SurfaceNoteText" Style="{DynamicResource WlCaption}"
                               Visibility="Collapsed" Margin="0,8,0,0" />

                    <!-- Definitions. First block, because it is the answer. -->
                    <StackPanel x:Name="DefinitionsBlock" Style="{DynamicResource WlArticleBlock}" Visibility="Collapsed">
                        <TextBlock Style="{DynamicResource WlMonoLabel}" controls:Type.Tracked="ЗНАЧЕНИЕ" />
                        <ItemsControl x:Name="DefinitionsList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{DynamicResource WlMonoNumber}"
                                                   Text="{Binding Number}"
                                                   Foreground="{DynamicResource WlBrand}"
                                                   Margin="0,3,14,0"
                                                   VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{DynamicResource WlBodyLarge}" Text="{Binding Text}" />
                                            <TextBlock Style="{DynamicResource WlCaption}"
                                                       Text="{Binding Meta}"
                                                       Visibility="{Binding MetaVisibility}"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- English translations. Clickable in both directions where the
                         installed data supports it. -->
                    <StackPanel x:Name="TranslationsBlock" Style="{DynamicResource WlArticleBlock}" Visibility="Collapsed">
                        <TextBlock x:Name="TranslationsLabel" Style="{DynamicResource WlMonoLabel}"
                                   controls:Type.Tracked="ПЕРЕВОД" />
                        <WrapPanel x:Name="TranslationsPanel" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Synonyms and antonyms, side by side on a wide window and
                         stacked when the window cannot hold two columns. -->
                    <StackPanel x:Name="SynonymsBlock" Style="{DynamicResource WlArticleBlock}" Visibility="Collapsed">
                        <TextBlock Style="{DynamicResource WlMonoLabel}" controls:Type.Tracked="СИНОНИМЫ" />
                        <WrapPanel x:Name="SynonymsPanel" Margin="0,12,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="AntonymsBlock" Style="{DynamicResource WlArticleBlock}" Visibility="Collapsed">
                        <TextBlock Style="{DynamicResource WlMonoLabel}" controls:Type.Tracked="АНТОНИМЫ" />
                        <WrapPanel x:Name="AntonymsPanel" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Forms. Behind a disclosure: a full paradigm is twenty values
                         and almost never the reason someone opened the word. -->
                    <StackPanel x:Name="FormsBlock" Style="{DynamicResource WlArticleBlock}" Visibility="Collapsed">
                        <ToggleButton x:Name="FormsToggle"
                                      Style="{DynamicResource WlDisclosure}"
                                      Content="ФОРМЫ"
                                      Checked="Disclosure_Toggled"
                                      Unchecked="Disclosure_Toggled" />
                        <TextBlock x:Name="FormsText" Style="{DynamicResource WlBody}"
                                   Foreground="{DynamicResource WlTextSecondary}"
                                   Visibility="Collapsed"
                                   Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="ExamplesBlock" Style="{DynamicResource WlArticleBlock}" Visibility="Collapsed">
                        <TextBlock Style="{DynamicResource WlMonoLabel}" controls:Type.Tracked="ПРИМЕРЫ" />
                        <ItemsControl x:Name="ExamplesList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource WlLineStrong}"
                                            BorderThickness="2,0,0,0"
                                            Padding="14,2,0,2"
                                            Margin="0,0,0,10">
                                        <TextBlock Style="{DynamicResource WlBodyLarge}"
                                                   Foreground="{DynamicResource WlTextSecondary}"
                                                   FontStyle="Italic"
                                                   Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="RelationsBlock" Style="{DynamicResource WlArticleBlock}" Visibility="Collapsed">
                        <TextBlock Style="{DynamicResource WlMonoLabel}" controls:Type.Tracked="СВЯЗАННЫЕ СЛОВА" />
                        <TextBlock x:Name="RelationsText" Style="{DynamicResource WlBody}"
                                   Foreground="{DynamicResource WlTextSecondary}" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- User-facing privacy provenance. Dataset attribution and licence
                         details live in the app's Third-party notices. -->
                    <TextBlock x:Name="SourceText" Style="{DynamicResource WlCaption}"
                               Foreground="{DynamicResource WlTextMuted}"
                               Margin="0,34,0,0" />
                </StackPanel>

                <!-- ── Loading ──────────────────────────────────────────────── -->
                <StackPanel x:Name="LoadingState" Visibility="Collapsed" Margin="0,28,0,0" MaxWidth="520" HorizontalAlignment="Left">
                    <Border Style="{DynamicResource WlSkeletonBar}" Width="220" Height="34" Margin="0,0,0,20" />
                    <Border Style="{DynamicResource WlSkeletonBar}" Width="120" Height="11" Margin="0,0,0,26" />
                    <Border Style="{DynamicResource WlSkeletonBar}" Width="70" Height="9" Margin="0,0,0,14" />
                    <Border Style="{DynamicResource WlSkeletonBar}" Width="480" />
                    <Border Style="{DynamicResource WlSkeletonBar}" Width="430" />
                    <Border Style="{DynamicResource WlSkeletonBar}" Width="290" />
                </StackPanel>

                <!-- ── Empty / status ──────────────────────────────────────── -->
                <StackPanel x:Name="LookupEmptyState" Margin="0,64,0,0" HorizontalAlignment="Left" MaxWidth="460">
                    <Path Style="{DynamicResource WlIconLg}"
                          Data="{DynamicResource WlIconDictionary}"
                          Stroke="{DynamicResource WlTextMuted}"
                          HorizontalAlignment="Left" />
                    <TextBlock x:Name="LookupEmptyTitle" Style="{DynamicResource WlSectionTitle}"
                               Text="Найдите слово" Margin="0,18,0,0" />
                    <TextBlock x:Name="LookupEmptyHint" Style="{DynamicResource WlSecondary}"
                               Text="Введите слово, чтобы увидеть его значение, формы, синонимы, антонимы и перевод."
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

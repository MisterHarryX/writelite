<UserControl x:Class="WriteLite.Views.Pages.DictionaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}">
    <UserControl.Resources>
        <!-- Строка слова: подсветка по наведению, кнопка удаления проявляется там же. -->
        <Style x:Key="WordItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource WlText}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WlHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WlBrandDim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WordDeleteButton" TargetType="Button" BasedOn="{StaticResource WlIconButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WlError}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="190" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Заголовок и счётчик ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Пользовательский словарь" Style="{DynamicResource WlPageTitle}" />
                <TextBlock Text="Слова из этого списка не считаются орфографическими ошибками. Данные хранятся отдельно от встроенных пакетов."
                           Style="{DynamicResource WlPageSubtitle}" Margin="0,7,0,0" />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Top" Margin="16,4,0,0"
                    Background="{DynamicResource WlBrandDim}" CornerRadius="999" Padding="12,5">
                <TextBlock x:Name="CountText" Text="0 слов" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource WlBrand}" />
            </Border>
        </Grid>

        <!-- ═══ Добавление и поиск ═══ -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WordInput" Grid.Column="0" Margin="0,0,8,0"
                         Style="{DynamicResource WlTextInput}"
                         Tag="Добавьте слово, которое не нужно подчёркивать"
                         KeyDown="WordInput_KeyDown" />
                <Button Grid.Column="1" Style="{DynamicResource WlPrimaryButton}" Content="Добавить"
                        Click="Add_Click" Padding="18,5" />
            </Grid>
            <TextBox x:Name="SearchBox" Style="{DynamicResource WlTextInput}"
                     Tag="Поиск по словарю" TextChanged="Search_Changed" />
        </StackPanel>

        <!-- ═══ Список слов ═══ -->
        <Border Grid.Row="2" Style="{DynamicResource WlPremiumCard}" Padding="8">
            <Grid>
                <ListBox x:Name="WordsList" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource WlText}" FontSize="13"
                         ItemContainerStyle="{StaticResource WordItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource WordDeleteButton}"
                                        Content="✕" ToolTip="Удалить из словаря"
                                        Click="RemoveWord_Click" CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource WlBrand}" Margin="10,10,0,3" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="330" Visibility="Collapsed">
                    <TextBlock Text="📖" FontSize="30" HorizontalAlignment="Center" Opacity="0.4" />
                    <TextBlock x:Name="EmptyTitle" Text="Словарь пуст" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource WlText}" HorizontalAlignment="Center"
                               Margin="0,10,0,4" />
                    <TextBlock x:Name="EmptyHint"
                               Text="Добавьте имена, термины и сокращения, которые не нужно подчёркивать."
                               Foreground="{DynamicResource WlTextSecondary}" FontSize="12"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{DynamicResource WlGhostButton}" Content="Очистить словарь" Click="Clear_Click" />
        </StackPanel>

        <!-- ═══ Словарные пакеты ═══ -->
        <Grid Grid.Row="4" Margin="0,22,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="СЛОВАРНЫЕ ПАКЕТЫ" Style="{DynamicResource WlSectionLabel}" />
                <TextBlock Text="Источники, лицензии и фактическое состояние установленных данных."
                           Style="{DynamicResource WlPageSubtitle}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource WlGhostButton}" Content="Обновить список" Click="RefreshPacks_Click" />
        </Grid>

        <Border Grid.Row="5" Style="{DynamicResource WlPremiumCard}" Padding="4">
            <DataGrid x:Name="PackList" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="None"
                      Background="Transparent" Foreground="{DynamicResource WlText}"
                      BorderThickness="0" RowBackground="{DynamicResource WlSurface}"
                      AlternatingRowBackground="{DynamicResource WlRaised}"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Пакет" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Язык" Binding="{Binding Language}" Width="70" />
                    <DataGridTextColumn Header="Статей" Binding="{Binding EntryCountDisplay}" Width="75" />
                    <DataGridTextColumn Header="Размер" Binding="{Binding SizeDisplay}" Width="75" />
                    <DataGridTextColumn Header="Лицензия" Binding="{Binding License}" Width="1.4*" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <WrapPanel Grid.Row="6" Margin="0,10,0,0">
            <Button Style="{DynamicResource WlPrimaryButton}" Content="Установить / импортировать" Click="ImportPack_Click" Margin="0,0,8,8" />
            <Button Style="{DynamicResource WlGhostButton}" Content="Проверить целостность" Click="VerifyPack_Click" Margin="0,0,8,8" />
            <Button Style="{DynamicResource WlGhostButton}" Content="Включить / отключить" Click="TogglePack_Click" Margin="0,0,8,8" />
            <Button Style="{DynamicResource WlGhostButton}" Content="Удалить" Click="RemovePack_Click" Margin="0,0,8,8" />
            <Button Style="{DynamicResource WlGhostButton}" Content="Источник и лицензия" Click="LicensePack_Click" Margin="0,0,8,8" />
        </WrapPanel>
    </Grid>
</UserControl>

<UserControl x:Class="WriteLite.Views.Pages.LocalEnginePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WriteLite.Controls"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}">
    <!--
        Local processing is part of the product identity, so it gets a real page —
        but the model is described as infrastructure, never as the headline.
        WriteLite is a writing application; the engine is what it runs on.
    -->
    <ScrollViewer Style="{DynamicResource WlScrollViewer}">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left" Margin="36,34,36,40">

            <controls:SectionHeader Index="05" Title="Локальный движок"
                                    Description="Проверка выполняется на этом компьютере. Недоступность модели не отключает базовую проверку." />

            <!-- Live status strip -->
            <Border Style="{DynamicResource WlCard}" Margin="0,20,0,0" Padding="18,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="6" Height="6"
                                 Fill="{DynamicResource WlSuccess}"
                                 VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock x:Name="StateText" Style="{DynamicResource WlSectionTitle}"
                                   Text="Движок активен" />
                    </StackPanel>
                    <TextBlock x:Name="StateDetail" Style="{DynamicResource WlSecondary}"
                               Text="Базовая проверка WriteLite" Margin="0,7,0,0" />

                    <Border Style="{DynamicResource WlHairline}" Margin="0,16,0,14" />

                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{DynamicResource WlMonoLabel}" controls:Type.Tracked="МОДЕЛЬ" />
                            <TextBlock x:Name="ModelText" Style="{DynamicResource WlMonoValue}"
                                       Foreground="{DynamicResource WlText}" Text="—" Margin="0,7,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{DynamicResource WlMonoLabel}" controls:Type.Tracked="СЛОВАРИ" />
                            <TextBlock x:Name="DictionariesText" Style="{DynamicResource WlMonoValue}"
                                       Foreground="{DynamicResource WlText}" Text="Загружены" Margin="0,7,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource WlMonoLabel}" controls:Type.Tracked="ИНТЕРНЕТ" />
                            <TextBlock Style="{DynamicResource WlMonoValue}"
                                       Foreground="{DynamicResource WlText}" Text="Не требуется" Margin="0,7,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Configuration read-out -->
            <controls:SectionHeader Title="Конфигурация" ShowRule="True" Margin="0,40,0,0" />
            <StackPanel Margin="0,4,0,0">
                <controls:SettingRow x:Name="RowLocalAi" Label="WriteAI"
                                     Description="Дополнительный слой после быстрых правил." />
                <controls:SettingRow x:Name="RowProfile" Label="Профиль"
                                     Description="Lite работает без Python и без сети; Quality нагружает CPU сильнее." />
                <controls:SettingRow x:Name="RowEndpoint" Label="Адрес сервера WriteAI"
                                     Description="Адрес локального сервера модели." />
            </StackPanel>

            <Button Style="{DynamicResource WlSecondaryButton}"
                    Content="Изменить в настройках"
                    HorizontalAlignment="Left"
                    Margin="0,20,0,0"
                    Click="OpenSettings_Click" />

            <!-- Privacy statement, stated once and not repeated across the app. -->
            <controls:SectionHeader Title="Обработка данных" Margin="0,40,0,0" />
            <TextBlock Style="{DynamicResource WlBody}"
                       Foreground="{DynamicResource WlTextSecondary}"
                       LineHeight="23"
                       Margin="0,18,0,0"
                       Text="Языковая модель и словари входят в комплект приложения и работают на CPU. Текст, проверяемый в локальном режиме, не покидает это устройство и не передаётся владельцу проекта." />
        </StackPanel>
    </ScrollViewer>
</UserControl>

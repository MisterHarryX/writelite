<UserControl x:Class="WriteLite.Views.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="760">
            <TextBlock Text="Диагностика" Style="{DynamicResource WlPageTitle}" />
            <TextBlock Text="Безопасные технические сведения без текста пользователя."
                       Style="{DynamicResource WlPageSubtitle}" Margin="0,6,0,18" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{DynamicResource WlPrimaryButton}" Content="Обновить" Click="Refresh_Click" Margin="0,0,8,0" />
                <Button Style="{DynamicResource WlGhostButton}" Content="Копировать отчёт" Click="Copy_Click" Margin="0,0,8,0" />
                <Button Style="{DynamicResource WlGhostButton}" Content="Открыть папку логов" Click="OpenLogs_Click" Margin="0,0,8,0" />
                <Button Style="{DynamicResource WlGhostButton}" Content="Перезапустить проверку" Click="RestartEngine_Click" />
            </StackPanel>

            <TextBlock Text="ПРИЛОЖЕНИЕ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WlTextSecondary}" Margin="0,0,0,8" />
            <Border Style="{DynamicResource WlCard}" Margin="0,0,0,16">
                <TextBlock x:Name="AppBlock" Foreground="{DynamicResource WlText}" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="АКТИВНОЕ ПОЛЕ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WlTextSecondary}" Margin="0,0,0,8" />
            <Border Style="{DynamicResource WlCard}" Margin="0,0,0,16">
                <TextBlock x:Name="FieldBlock" Foreground="{DynamicResource WlText}" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="ЯЗЫКОВОЙ ДВИЖОК" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WlTextSecondary}" Margin="0,0,0,8" />
            <Border Style="{DynamicResource WlCard}" Margin="0,0,0,16">
                <TextBlock x:Name="EngineBlock" Foreground="{DynamicResource WlText}" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="СИСТЕМА" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WlTextSecondary}" Margin="0,0,0,8" />
            <Border Style="{DynamicResource WlCard}" Margin="0,0,0,16">
                <TextBlock x:Name="SystemBlock" Foreground="{DynamicResource WlText}" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="ПОСЛЕДНИЕ СОБЫТИЯ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WlTextSecondary}" Margin="0,0,0,8" />
            <Border Style="{DynamicResource WlCard}" Padding="8" MaxHeight="240">
                <ListBox x:Name="EventsList" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource WlTextSecondary}" FontSize="11" FontFamily="Consolas" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="WriteLite.Views.Pages.ExceptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="720">
            <TextBlock Text="Исключения" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WlText}" />
            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource WlTextSecondary}" Margin="0,8,0,20"
                       Text="Словарь отключает проверку орфографии для слова. Исключения правил скрывают конкретные типы замечаний WriteLite (WL-id). Временные «Игнорировать» в панели действуют до изменения текста и здесь не хранятся." />

            <TextBlock Text="ИГНОРИРУЕМЫЕ СЛОВА" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WlTextSecondary}" Margin="0,0,0,8" />
            <Border Style="{DynamicResource WlCard}" Margin="0,0,0,16" Padding="0" MinHeight="120">
                <ListBox x:Name="WordsList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource WlText}" />
            </Border>
            <Button Style="{DynamicResource WlGhostButton}" Content="Удалить выбранное слово" HorizontalAlignment="Left" Click="RemoveWord_Click" Margin="0,0,0,20" />

            <TextBlock Text="ИГНОРИРУЕМЫЕ ПРАВИЛА" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WlTextSecondary}" Margin="0,0,0,8" />
            <Border Style="{DynamicResource WlCard}" Padding="0" MinHeight="120">
                <ListBox x:Name="RulesList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource WlText}" />
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{DynamicResource WlGhostButton}" Content="Удалить правило" Click="RemoveRule_Click" Margin="0,0,8,0" />
                <Button Style="{DynamicResource WlGhostButton}" Content="Очистить все исключения" Click="ClearAll_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

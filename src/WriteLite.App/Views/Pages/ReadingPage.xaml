<UserControl x:Class="WriteLite.Views.Pages.ReadingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WriteLite.Controls"
             xmlns:pages="clr-namespace:WriteLite.Views.Pages"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}"
             AllowDrop="True"
             DragOver="Page_DragOver"
             Drop="Page_Drop"
             AutomationProperties.Name="Чтение">
    <Grid>
        <!-- ═══ Library ═════════════════════════════════════════════════════ -->
        <Grid x:Name="LibraryView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="36,32,36,0">
                <TextBlock Style="{DynamicResource WlMonoLabel}"
                           controls:Type.Tracked="ЧТЕНИЕ"
                           Foreground="{DynamicResource WlBrand}" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{DynamicResource WlPageTitle}" Text="Проекты чтения" />
                        <TextBlock Style="{DynamicResource WlPageSubtitle}"
                                   Text="Книга, ваше место в ней, пометки, закладки и карточки — всё возвращается там, где вы остановились."
                                   MaxWidth="620"
                                   HorizontalAlignment="Left"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <Button x:Name="OpenBookButton"
                            Grid.Column="1"
                            Style="{DynamicResource WlPrimaryButton}"
                            VerticalAlignment="Top"
                            Margin="20,2,0,0"
                            Click="OpenBook_Click"
                            AutomationProperties.Name="Открыть книгу">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource WlIconSm}"
                                  Data="{DynamicResource WlIconOpenDocument}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Открыть книгу" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <ScrollViewer x:Name="LibraryScroll" Grid.Row="1" Style="{DynamicResource WlScrollViewer}"
                          Margin="0,10,0,0" Padding="36,0,24,24">
                <StackPanel>
                    <!-- ── Continue ───────────────────────────────────────── -->
                    <StackPanel x:Name="ContinueSection" Visibility="Collapsed">
                        <controls:SectionHeader Index="01" Title="Продолжить чтение" Margin="0,22,0,0" />

                        <Border x:Name="ContinueCard"
                                Style="{DynamicResource WlReadingCard}"
                                Margin="0,16,0,0"
                                MaxWidth="760"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                MouseLeftButtonUp="Continue_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="ContinueTitle" Style="{DynamicResource WlSectionTitle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ContinueDetails" Style="{DynamicResource WlCaption}"
                                               Margin="0,7,0,0" />
                                    <Grid Margin="0,14,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420">
                                        <Border Style="{DynamicResource WlProgressTrack}" />
                                        <Border x:Name="ContinueProgress" Style="{DynamicResource WlProgressFill}" Width="0" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Style="{DynamicResource WlMonoLabel}"
                                           controls:Type.Tracked="ПРОДОЛЖИТЬ →"
                                           Foreground="{DynamicResource WlBrand}"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ── Library ────────────────────────────────────────── -->
                    <controls:SectionHeader x:Name="LibraryHeader" Index="02" Title="Библиотека" Margin="0,40,0,0" />

                    <WrapPanel x:Name="ProjectsPanel" Margin="0,16,0,0" />

                    <StackPanel x:Name="EmptyState" MaxWidth="540" HorizontalAlignment="Left" Margin="0,18,0,0">
                        <TextBlock Style="{DynamicResource WlSectionTitle}" Text="Здесь пока нет книг" />
                        <TextBlock Style="{DynamicResource WlSecondary}"
                                   Text="Откройте PDF, DOCX, ODT или TXT — WriteLite создаст проект чтения и запомнит вашу работу с книгой. Файл можно просто перетащить сюда."
                                   Margin="0,8,0,0" />
                        <TextBlock Style="{DynamicResource WlCaption}"
                                   Text="Проекты хранятся на этом компьютере. Аккаунт не нужен, интернет не используется."
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="0,1,0,0"
                    Padding="36,0">
                <Grid Height="30">
                    <TextBlock x:Name="StatusText"
                               Style="{DynamicResource WlMonoLabel}"
                               Foreground="{DynamicResource WlTextMuted}"
                               VerticalAlignment="Center" />
                    <TextBlock Style="{DynamicResource WlMonoLabel}"
                               Foreground="{DynamicResource WlTextMuted}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               controls:Type.Tracked="PDF · DOCX · ODT · TXT" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Reader ══════════════════════════════════════════════════════ -->
        <pages:ReaderView x:Name="Reader" Visibility="Collapsed" />
    </Grid>
</UserControl>

<UserControl x:Class="WriteLite.Views.Pages.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}"
             AllowDrop="True"
             DragOver="Page_DragOver"
             Drop="Page_Drop">
    <!--
        «Музыка»: the player that lives in the rail, given a room of its own — what is playing,
        the whole library, and the ways to fill it (files, folders, drag and drop).
    -->
    <DockPanel>
        <!-- ═══ Now playing ═══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Padding="32,28,32,22" BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Artwork" Width="132" Height="132" CornerRadius="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="ArtStop1" Color="#FFF26B0F" Offset="0" />
                            <GradientStop x:Name="ArtStop2" Color="#FF3A1606" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Path Data="{DynamicResource WlIconMusic}" Stroke="#CCFFFFFF" StrokeThickness="1.4"
                              Stretch="Uniform" Width="54" Height="54" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="26,4,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource WlMonoLabel}" Text="СЕЙЧАС ИГРАЕТ" />
                    <TextBlock x:Name="NowTitle" Text="Ничего не выбрано" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource WlText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowArtist" Style="{DynamicResource WlSecondary}" Margin="0,4,0,0" />

                    <Grid Margin="0,16,0,0" MaxWidth="560" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Text="0:00" Style="{DynamicResource WlMonoValue}" FontSize="11"
                                   Foreground="{DynamicResource WlTextMuted}" VerticalAlignment="Center" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Style="{DynamicResource WlSlider}" Minimum="0" Maximum="1"
                                IsMoveToPointEnabled="True" VerticalAlignment="Center" MinWidth="240"
                                PreviewMouseLeftButtonDown="Seek_MouseDown" PreviewMouseLeftButtonUp="Seek_MouseUp"
                                AutomationProperties.Name="Позиция в треке" />
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Style="{DynamicResource WlMonoValue}" FontSize="11"
                                   Foreground="{DynamicResource WlTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ToggleButton x:Name="ShuffleButton" Style="{DynamicResource WlFormatToggle}" Click="Shuffle_Click"
                                      ToolTip="Перемешать" AutomationProperties.Name="Перемешать">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconShuffle}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </ToggleButton>
                        <Button Style="{DynamicResource WlIconButton}" Width="38" Height="38" Margin="8,0,0,0" Click="Previous_Click"
                                ToolTip="Предыдущий" AutomationProperties.Name="Предыдущий">
                            <Path Style="{DynamicResource WlIcon}" Data="{DynamicResource WlIconPrevious}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="PlayButton" Width="48" Height="48" Margin="6,0" Click="Play_Click" Cursor="Hand"
                                ToolTip="Воспроизвести" AutomationProperties.Name="Воспроизвести">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Disc" CornerRadius="24" Background="{DynamicResource WlBrand}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Disc" Property="Background" Value="{DynamicResource WlBrandHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path x:Name="PlayIcon" Style="{DynamicResource WlIcon}" Data="{DynamicResource WlIconPlay}"
                                  Stroke="{DynamicResource WlOnBrand}" Fill="{DynamicResource WlOnBrand}" />
                        </Button>
                        <Button Style="{DynamicResource WlIconButton}" Width="38" Height="38" Click="Next_Click"
                                ToolTip="Следующий" AutomationProperties.Name="Следующий">
                            <Path Style="{DynamicResource WlIcon}" Data="{DynamicResource WlIconNext}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <ToggleButton x:Name="RepeatButton" Style="{DynamicResource WlFormatToggle}" Margin="8,0,0,0" Click="Repeat_Click"
                                      ToolTip="Повторять трек" AutomationProperties.Name="Повторять трек">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconRepeat}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </ToggleButton>

                        <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconVolume}" Margin="28,0,8,0"
                              Stroke="{DynamicResource WlTextMuted}" VerticalAlignment="Center" />
                        <Slider x:Name="VolumeSlider" Style="{DynamicResource WlSlider}" Width="120" Minimum="0" Maximum="1"
                                VerticalAlignment="Center" ValueChanged="Volume_Changed" IsMoveToPointEnabled="True"
                                AutomationProperties.Name="Громкость" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Library toolbar ═══════════════════════════════════════════════ -->
        <Grid DockPanel.Dock="Top" Margin="32,16,32,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabAll" Style="{DynamicResource WlTabButton}" Content="Все треки" IsChecked="True"
                             GroupName="MusicTabs" Checked="Tab_Checked" />
                <RadioButton x:Name="TabFavorites" Style="{DynamicResource WlTabButton}" Content="Избранное"
                             GroupName="MusicTabs" Checked="Tab_Checked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="SearchBox" Style="{DynamicResource WlSearchInput}" Width="220" Tag="Поиск"
                         TextChanged="Search_Changed" AutomationProperties.Name="Поиск по музыке" />
                <Button Style="{DynamicResource WlSecondaryButton}" Content="Добавить файлы" Margin="10,0,0,0" Padding="12,0"
                        Click="AddFiles_Click" />
                <Button Style="{DynamicResource WlSecondaryButton}" Content="Добавить папку" Margin="8,0,0,0" Padding="12,0"
                        Click="AddFolder_Click" />
            </StackPanel>
        </Grid>

        <!-- ═══ Tracks ════════════════════════════════════════════════════════ -->
        <Grid Margin="20,0,20,12">
            <ListBox x:Name="TrackList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="TrackList_MouseDoubleClick" KeyDown="TrackList_KeyDown"
                     AutomationProperties.Name="Треки">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="12,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WlHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WlBrandSoft}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" FontFamily="{DynamicResource WlFontMono}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="{Binding Weight}"
                                       Foreground="{DynamicResource WlText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Artist}" FontSize="12" Margin="12,0,0,0"
                                       Foreground="{DynamicResource WlTextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="{Binding Star}" Tag="{Binding}" Click="Favorite_Click"
                                    Style="{DynamicResource WlTextButton}" Foreground="{Binding StarBrush}"
                                    FontSize="14" Padding="4,0" ToolTip="Избранное" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Добавьте свою музыку" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource WlText}"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{DynamicResource WlCaption}" Margin="0,6,0,14" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="Перетащите сюда файлы или папку, либо подключите папку «Музыка» Windows." />
                <Button Style="{DynamicResource WlPrimaryButton}" Content="Подключить папку «Музыка»" Padding="16,0" MinHeight="32"
                        HorizontalAlignment="Center" Click="AddMyMusic_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

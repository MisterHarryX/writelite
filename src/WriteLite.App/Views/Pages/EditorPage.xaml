<UserControl x:Class="WriteLite.Views.Pages.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WlBgBase}"
             FontFamily="{DynamicResource WlFont}"
             AutomationProperties.Name="Редактор WriteLite">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource WlBg}"
                BorderBrush="{DynamicResource WlBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Редактор" Foreground="{DynamicResource WlText}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Локальная проверка без переключения в другое приложение"
                               Foreground="{DynamicResource WlTextMuted}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource WlSuccessSoft}" BorderBrush="{DynamicResource WlSuccessBorder}"
                            BorderThickness="1" CornerRadius="999" Padding="9,4" Margin="0,0,10,0">
                        <TextBlock Text="●  Локально" Foreground="{DynamicResource WlSuccessText}" FontSize="11" />
                    </Border>
                    <Border Background="{DynamicResource WlSurface}" BorderBrush="{DynamicResource WlBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12,6"
                            AutomationProperties.Name="Язык анализа: русский">
                        <TextBlock Text="Русский" Foreground="{DynamicResource WlText}" FontSize="12" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Margin="22,20,18,16">
            <Border Style="{DynamicResource WlPremiumCard}" Padding="0" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource WlRaised}" BorderBrush="{DynamicResource WlBorder}"
                            BorderThickness="0,0,0,1" CornerRadius="14,14,0,0">
                        <Grid Margin="14,0">
                            <TextBlock Text="ТЕКСТ" Style="{DynamicResource WlSectionLabel}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Очистить" Style="{DynamicResource WlGhostButton}" Padding="10,3"
                                        Click="Clear_Click" AutomationProperties.Name="Очистить редактор" />
                                <Button Content="Проверить" Style="{DynamicResource WlPrimaryButton}" Padding="11,3" Margin="8,0,0,0"
                                        Click="Recheck_Click" AutomationProperties.Name="Повторно проверить текст" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBox x:Name="EditorTextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent" Foreground="{DynamicResource WlText}" BorderThickness="0"
                             CaretBrush="{DynamicResource WlBrand}" SelectionBrush="{DynamicResource WlBrandDim}"
                             FontSize="16" Padding="24,22" TextChanged="EditorTextBox_TextChanged"
                             SpellCheck.IsEnabled="False" AutomationProperties.Name="Текст для проверки" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource WlBg}"
                BorderBrush="{DynamicResource WlBorder}" BorderThickness="1,0,0,0">
            <Grid Margin="16,18,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Предложения" Foreground="{DynamicResource WlText}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="IssueCountText" Text="Замечаний нет" Foreground="{DynamicResource WlTextMuted}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource WlBrandDim}"
                            CornerRadius="999" Padding="8,3">
                        <TextBlock x:Name="IssueBadge" Text="0" Foreground="{DynamicResource WlBrand}" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
                    <Button Content="Все" Style="{DynamicResource WlGhostButton}" Padding="10,3" IsEnabled="False" />
                    <TextBlock x:Name="AnalysisStateText" Text="Введите текст" Foreground="{DynamicResource WlTextMuted}"
                               FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <ListBox x:Name="IssuesList" ItemsSource="{Binding Issues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="IssuesList_SelectionChanged" AutomationProperties.Name="Список замечаний"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,9" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource WlSurface}" BorderBrush="{DynamicResource WlBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="13">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding CategoryBrush}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding CategoryBrush}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource WlTextMuted}" FontSize="10"
                                                       HorizontalAlignment="Right" Margin="10,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ChangeLabel}" Foreground="{DynamicResource WlText}" FontSize="14"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0" />
                                        <TextBlock Text="{Binding Explanation}" Foreground="{DynamicResource WlTextSecondary}" FontSize="12"
                                                   TextWrapping="Wrap" MaxHeight="54" Margin="0,6,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                            <Button Content="Исправить" Style="{DynamicResource WlPrimaryButton}" Padding="10,3"
                                                    Tag="{Binding}" Click="ApplyIssue_Click" />
                                            <Button Content="Игнорировать" Style="{DynamicResource WlGhostButton}" Padding="10,3" Margin="7,0,0,0"
                                                    Tag="{Binding}" Click="IgnoreIssue_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="230">
                        <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource WlSuccessSoft}"
                                BorderBrush="{DynamicResource WlSuccessBorder}" BorderThickness="1">
                            <TextBlock Text="✓" Foreground="{DynamicResource WlSuccess}" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Всё отлично" Foreground="{DynamicResource WlText}" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Новых замечаний не найдено" Foreground="{DynamicResource WlTextMuted}" FontSize="11"
                                   TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Button Grid.Row="3" x:Name="ApplySafeButton" Content="Исправить безопасные"
                        Style="{DynamicResource WlFooterPrimaryButton}" Margin="0,12,0,0"
                        Click="ApplySafe_Click" AutomationProperties.Name="Исправить все безопасные замечания" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource WlBg}"
                BorderBrush="{DynamicResource WlBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="WordCountText" Text="0 слов" Foreground="{DynamicResource WlTextMuted}" FontSize="11" />
                    <TextBlock Text="•" Foreground="{DynamicResource WlBorder}" Margin="10,0" />
                    <TextBlock Text="Системная проверка в редакторе отключена" Foreground="{DynamicResource WlTextMuted}" FontSize="11" />
                </StackPanel>
                <TextBlock Text="Ctrl+Enter — проверить" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource WlTextMuted}" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="WriteLite.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WriteLite.Controls"
        xmlns:res="clr-namespace:WriteLite.Resources"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WriteLite"
        Width="1240"
        Height="780"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="False"
        FontFamily="{DynamicResource WlFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SizeChanged="Window_SizeChanged"
        ShowInTaskbar="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome" CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <!-- No inset here any more. A maximised chromeless window used to overhang the
         work area by the resize frame — 55 px past the taskbar on a 1080p screen —
         and this border carried a 7 px margin to hide some of it. ShellWindowBehavior
         now answers WM_GETMINMAXINFO with the monitor's real work area, so the window
         is the right size and the margin would only put a gap around it. -->
    <Border x:Name="RootShell"
            Background="{DynamicResource WlBgBase}"
            BorderBrush="{DynamicResource WlLineStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ 00  Title bar ═══════════════════════════════════════════ -->
            <Border x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:WriteLiteLogo LogoSize="24" />
                        <TextBlock Text="WriteLite"
                                   Foreground="{DynamicResource WlText}"
                                   FontFamily="{DynamicResource WlFontDisplay}"
                                   FontSize="13.5"
                                   FontWeight="Medium"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="14" Background="{DynamicResource WlLineStrong}" Margin="13,0" />
                        <TextBlock x:Name="PageNameText"
                                   Style="{DynamicResource WlMonoLabel}"
                                   controls:Type.Tracked="{x:Static res:Strings.Main_PageName_Home}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Local-processing identity. Present but quiet: one dot, one word. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <Ellipse x:Name="EngineDot" Width="5" Height="5"
                                 Fill="{DynamicResource WlSuccess}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="EngineStateText"
                                   Style="{DynamicResource WlMonoLabel}"
                                   controls:Type.Tracked="{x:Static res:Strings.Main_EngineState}"
                                   Foreground="{DynamicResource WlTextSubtle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{DynamicResource WlWindowButton}" ToolTip="{x:Static res:Strings.Main_Minimize}" Click="Minimize_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Main_MinimizeWindow}">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconMinimize}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{DynamicResource WlWindowButton}"
                                ToolTip="{x:Static res:Strings.Main_Maximize}" Click="Maximize_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Main_MaximizeWindow}">
                            <Path x:Name="MaximizeIcon" Style="{DynamicResource WlIconSm}"
                                  Width="12" Height="12"
                                  Data="{DynamicResource WlIconMaximize}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{DynamicResource WlWindowCloseButton}" ToolTip="{x:Static res:Strings.Main_CloseToTray}" Click="Close_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Main_CloseWindow}">
                            <Path Style="{DynamicResource WlIconSm}" Data="{DynamicResource WlIconClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Navigation rail ═════════════════════════════════════════ -->
            <Border x:Name="Rail" Grid.Row="1" Grid.Column="0" Style="{DynamicResource WlNavigationRail}">
                <DockPanel>
                    <!-- The rail's foot: ambience, then the way out. Two hairlines
                         where there used to be one, but each now separates things
                         that genuinely belong to different jobs. -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <controls:AmbienceBar x:Name="Ambience" Margin="0,8,0,4" />
                        <Border Style="{DynamicResource WlHairline}" Margin="8,8,8,8" />
                        <Button x:Name="ExitButton" Style="{DynamicResource WlNavButton}"
                                Content="{x:Static res:Strings.Main_Exit}" Click="Exit_Click"
                                ToolTip="{x:Static res:Strings.Main_Exit_Tooltip}" />
                        <TextBlock x:Name="RailFootnote"
                                   Style="{DynamicResource WlMonoLabel}"
                                   controls:Type.Tracked="{x:Static res:Strings.Main_Footnote}"
                                   Foreground="{DynamicResource WlTextMuted}"
                                   Margin="10,10,0,2" />
                    </StackPanel>

                    <ScrollViewer Style="{DynamicResource WlScrollViewer}">
                      <Grid>
                        <!-- One indicator for the whole rail, moved by
                             MoveNavIndicator. It sits behind the items and scrolls
                             with them because it shares their coordinate space. -->
                        <Border x:Name="NavIndicator" Style="{DynamicResource WlNavIndicator}" Height="20" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavIndicatorShift" />
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel x:Name="NavStack">
                            <TextBlock x:Name="GroupWorkspace"
                                       Style="{DynamicResource WlMonoLabel}"
                                       controls:Type.Tracked="{x:Static res:Strings.Main_GroupWorkspace}"
                                       Foreground="{DynamicResource WlTextMuted}"
                                       Margin="12,10,0,8" />

                            <controls:NavItem x:Name="NavHome" GroupName="MainNav" IsChecked="True"
                                              Index="01" Label="{x:Static res:Strings.Nav_Home}" Icon="{DynamicResource WlIconHome}"
                                              Checked="Nav_Checked" />
                            <controls:NavItem x:Name="NavPanel" GroupName="MainNav"
                                              Index="02" Label="{x:Static res:Strings.Nav_Editor}" Icon="{DynamicResource WlIconEditor}"
                                              Checked="Nav_Checked" />
                            <controls:NavItem x:Name="NavReading" GroupName="MainNav"
                                              Index="03" Label="{x:Static res:Strings.Nav_Reading}" Icon="{DynamicResource WlIconReading}"
                                              ToolTip="{x:Static res:Strings.Nav_Reading_Tooltip}"
                                              Checked="Nav_Checked" />
                            <controls:NavItem x:Name="NavNotes" GroupName="MainNav"
                                              Index="04" Label="{x:Static res:Strings.Nav_Notes}" Icon="{DynamicResource WlIconNotes}"
                                              ToolTip="{x:Static res:Strings.Nav_Notes_Tooltip}"
                                              Checked="Nav_Checked" />
                            <controls:NavItem x:Name="NavConverter" GroupName="MainNav"
                                              Index="05" Label="{x:Static res:Strings.Nav_Converter}" Icon="{DynamicResource WlIconConvert}"
                                              ToolTip="{x:Static res:Strings.Nav_Converter_Tooltip}"
                                              Checked="Nav_Checked" />
                            <controls:NavItem x:Name="NavDictionary" GroupName="MainNav"
                                              Index="06" Label="{x:Static res:Strings.Nav_Dictionary}" Icon="{DynamicResource WlIconDictionary}"
                                              Checked="Nav_Checked" />
                            <controls:NavItem x:Name="NavWords" GroupName="MainNav"
                                              Index="07" Label="{x:Static res:Strings.Nav_WordsManager}" Icon="{DynamicResource WlIconWords}"
                                              Checked="Nav_Checked" />

                            <TextBlock x:Name="GroupSystem"
                                       Style="{DynamicResource WlMonoLabel}"
                                       controls:Type.Tracked="{x:Static res:Strings.Main_GroupSystem}"
                                       Foreground="{DynamicResource WlTextMuted}"
                                       Margin="12,22,0,8" />

                            <controls:NavItem x:Name="NavLocalAi" GroupName="MainNav"
                                              Index="08" Label="{x:Static res:Strings.Nav_LocalAi}" Icon="{DynamicResource WlIconEngine}"
                                              ToolTip="{x:Static res:Strings.Nav_LocalAi_Tooltip}"
                                              Checked="Nav_Checked" />
                            <controls:NavItem x:Name="NavApps" GroupName="MainNav"
                                              Index="09" Label="{x:Static res:Strings.Nav_Compatibility}" Icon="{DynamicResource WlIconApps}"
                                              Checked="Nav_Checked" />
                            <controls:NavItem x:Name="NavSettings" GroupName="MainNav"
                                              Index="10" Label="{x:Static res:Strings.Common_Settings}" Icon="{DynamicResource WlIconSettings}"
                                              Checked="Nav_Checked" />
                            <controls:NavItem x:Name="NavDiagnostics" GroupName="MainNav"
                                              Index="11" Label="{x:Static res:Strings.Nav_Diagnostics}" Icon="{DynamicResource WlIconDiagnostics}"
                                              Checked="Nav_Checked" />
                            <controls:NavItem x:Name="NavAbout" GroupName="MainNav"
                                              Index="12" Label="{x:Static res:Strings.Nav_About}" Icon="{DynamicResource WlIconAbout}"
                                              Checked="Nav_Checked" />
                        </StackPanel>
                      </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ═══ Page host ═══════════════════════════════════════════════ -->
            <ContentControl x:Name="PageHost"
                            Grid.Row="1" Grid.Column="1"
                            Background="{DynamicResource WlBgBase}"
                            KeyboardNavigation.TabNavigation="Cycle" />
        </Grid>
    </Border>
</Window>

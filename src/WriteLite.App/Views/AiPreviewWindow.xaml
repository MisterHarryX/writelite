<Window x:Class="WriteLite.Views.AiPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WriteLite.Controls"
        xmlns:res="clr-namespace:WriteLite.Resources"
        Title="WriteLite AI"
        Width="720"
        Height="620"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource WlFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AutomationProperties.Name="{x:Static res:Strings.AiPreview_AutomationName}">
    <Border Background="{DynamicResource WlBgBase}"
            BorderBrush="{DynamicResource WlLineStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ Header ══════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{DynamicResource WlIconSm}"
                              Data="{DynamicResource WlIconAi}"
                              Stroke="{DynamicResource WlBrand}"
                              VerticalAlignment="Center" />
                        <TextBlock Style="{DynamicResource WlMonoLabel}"
                                   controls:Type.Tracked="WRITELITE AI"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Style="{DynamicResource WlToolbarRule}" Margin="12,0" />
                        <TextBlock x:Name="OperationText"
                                   Style="{DynamicResource WlCaption}"
                                   Foreground="{DynamicResource WlTextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Style="{DynamicResource WlWindowCloseButton}"
                            HorizontalAlignment="Right"
                            Click="Cancel_Click"
                            AutomationProperties.Name="{x:Static res:Strings.AiPreview_Close}">
                        <Path Style="{DynamicResource WlIconSm}"
                              Data="{DynamicResource WlIconClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ Working state ═══════════════════════════════════════════ -->
            <Border x:Name="BusyBar"
                    Grid.Row="1"
                    Background="{DynamicResource WlBgSoft}"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="0,0,0,1"
                    Padding="18,10"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource WlMonoLabel}"
                               controls:Type.Tracked="{x:Static res:Strings.AiPreview_ProcessingLabel}"
                               Foreground="{DynamicResource WlBrand}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="BusyText"
                               Style="{DynamicResource WlCaption}"
                               Text="{x:Static res:Strings.AiPreview_ProcessingText}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                    <Button Content="{x:Static res:Strings.Editor_CancelOperation}"
                            Style="{DynamicResource WlToolbarButton}"
                            Margin="12,0,0,0"
                            Click="StopGeneration_Click"
                            AutomationProperties.Name="{x:Static res:Strings.AiPreview_CancelProcessing}" />
                </StackPanel>
            </Border>

            <!-- ═══ Original / suggestion ═══════════════════════════════════ -->
            <ScrollViewer Grid.Row="2" Style="{DynamicResource WlScrollViewer}" Padding="18,16,14,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource WlPanelLabel}"
                               controls:Type.Tracked="{x:Static res:Strings.AiPreview_OriginalLabel}" />
                    <Border Style="{DynamicResource WlInsetPanel}" Padding="14,12">
                        <TextBlock x:Name="OriginalText"
                                   Style="{DynamicResource WlBody}"
                                   Foreground="{DynamicResource WlTextSecondary}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Style="{DynamicResource WlPanelLabel}"
                               controls:Type.Tracked="{x:Static res:Strings.AiPreview_SuggestionLabel}"
                               Margin="0,18,0,7" />
                    <Border Style="{DynamicResource WlInsetPanel}"
                            Padding="14,12"
                            BorderBrush="{DynamicResource WlLineAccent}">
                        <TextBlock x:Name="SuggestionText"
                                   Style="{DynamicResource WlBody}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- The provenance line. Which local path answered is part of the
                         answer: a rule fallback is not the model and must not read
                         as though it were. -->
                    <TextBlock x:Name="BackendText"
                               Style="{DynamicResource WlCaption}"
                               Foreground="{DynamicResource WlTextMuted}"
                               TextWrapping="Wrap"
                               Margin="2,12,0,0" />

                    <Border x:Name="NoticePanel"
                            Style="{DynamicResource WlInsetPanel}"
                            BorderBrush="{DynamicResource WlWarningBorder}"
                            Background="{DynamicResource WlWarningSoft}"
                            Padding="14,11"
                            Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="NoticeText"
                                   Style="{DynamicResource WlCaption}"
                                   Foreground="{DynamicResource WlWarning}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ Actions ═════════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9"
                    Padding="18,12">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RetryButton"
                                Content="{x:Static res:Strings.AiPreview_Retry}"
                                Style="{DynamicResource WlSecondaryButton}"
                                Click="Retry_Click"
                                AutomationProperties.Name="{x:Static res:Strings.AiPreview_RetryAutomation}" />
                        <Button Content="{x:Static res:Strings.EditorAi_Copy}"
                                Style="{DynamicResource WlTextButton}"
                                Margin="6,0,0,0"
                                Click="Copy_Click"
                                AutomationProperties.Name="{x:Static res:Strings.AiPreview_CopyAutomation}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static res:Strings.EditorAi_Cancel}"
                                Style="{DynamicResource WlTextButton}"
                                Click="Cancel_Click"
                                AutomationProperties.Name="{x:Static res:Strings.AiPreview_CancelAutomation}" />
                        <Button x:Name="InsertButton"
                                Content="{x:Static res:Strings.AiPreview_InsertBelow}"
                                Style="{DynamicResource WlSecondaryButton}"
                                Margin="6,0,0,0"
                                Click="Insert_Click"
                                AutomationProperties.Name="{x:Static res:Strings.AiPreview_InsertBelowAutomation}" />
                        <Button x:Name="ReplaceButton"
                                Content="{x:Static res:Strings.Editor_Replace}"
                                Style="{DynamicResource WlPrimaryButton}"
                                MinHeight="30"
                                Margin="6,0,0,0"
                                IsDefault="True"
                                Click="Replace_Click"
                                AutomationProperties.Name="{x:Static res:Strings.AiPreview_ReplaceAutomation}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="WriteLite.Views.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WriteLite.Controls"
        Title="Заметка"
        Width="640"
        Height="640"
        MinWidth="460"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource WlFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AutomationProperties.Name="Редактор заметки">
    <Border Background="{DynamicResource WlBgBase}"
            BorderBrush="{DynamicResource WlLineStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ Header ══════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{DynamicResource WlIconSm}"
                              Data="{DynamicResource WlIconNotes}"
                              Stroke="{DynamicResource WlBrand}"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="KindLabel"
                                   Style="{DynamicResource WlMonoLabel}"
                                   controls:Type.Tracked="ЗАМЕТКА"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="PinButton"
                                Style="{DynamicResource WlIconButton}"
                                Width="30" Height="30"
                                Click="Pin_Click"
                                ToolTip="Закрепить"
                                AutomationProperties.Name="Закрепить заметку">
                            <Path x:Name="PinIcon" Style="{DynamicResource WlIconSm}"
                                  Data="{DynamicResource WlIconPin}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{DynamicResource WlWindowCloseButton}"
                                Click="Cancel_Click"
                                ToolTip="Закрыть без сохранения"
                                AutomationProperties.Name="Закрыть">
                            <Path Style="{DynamicResource WlIconSm}"
                                  Data="{DynamicResource WlIconClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Title and kind ══════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="24,20,24,0">
                <TextBox x:Name="TitleBox"
                         Style="{DynamicResource WlTextInput}"
                         FontSize="17"
                         Tag="Название"
                         MaxLength="200"
                         AutomationProperties.Name="Название заметки" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <RadioButton x:Name="KindNote" Style="{DynamicResource WlTabButton}"
                                 Content="Заметка" GroupName="NoteKind" IsChecked="True"
                                 Checked="Kind_Changed" />
                    <RadioButton x:Name="KindTask" Style="{DynamicResource WlTabButton}"
                                 Content="Задача" GroupName="NoteKind"
                                 Checked="Kind_Changed" />
                    <RadioButton x:Name="KindChecklist" Style="{DynamicResource WlTabButton}"
                                 Content="Список" GroupName="NoteKind"
                                 Checked="Kind_Changed" />
                    <RadioButton x:Name="KindGoal" Style="{DynamicResource WlTabButton}"
                                 Content="Цель" GroupName="NoteKind"
                                 Checked="Kind_Changed" />
                </StackPanel>

                <Border Style="{DynamicResource WlHairline}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- ═══ Body ════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="2" Style="{DynamicResource WlScrollViewer}" Margin="0,16,0,0" Padding="24,0,16,0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource WlMonoLabel}"
                               controls:Type.Tracked="ТЕКСТ"
                               Foreground="{DynamicResource WlTextMuted}" />

                    <TextBox x:Name="TextBoxBody"
                             Style="{DynamicResource WlTextInput}"
                             Margin="0,8,0,0"
                             MinHeight="120"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             SpellCheck.IsEnabled="False"
                             Tag="О чём эта заметка"
                             ContextMenuOpening="Body_ContextMenuOpening"
                             AutomationProperties.Name="Текст заметки" />

                    <!-- ── Checklist ──────────────────────────────────────── -->
                    <StackPanel x:Name="ChecklistSection" Margin="0,22,0,0" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="ChecklistLabel"
                                       Style="{DynamicResource WlMonoLabel}"
                                       controls:Type.Tracked="ПУНКТЫ"
                                       Foreground="{DynamicResource WlTextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ChecklistProgress"
                                       Style="{DynamicResource WlMonoLabel}"
                                       Foreground="{DynamicResource WlTextMuted}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel x:Name="ItemsPanel" Margin="0,10,0,0" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewItemBox"
                                     Grid.Column="0"
                                     Style="{DynamicResource WlSmallInput}"
                                     Tag="Новый пункт"
                                     KeyDown="NewItem_KeyDown"
                                     AutomationProperties.Name="Новый пункт списка" />
                            <Button Grid.Column="1"
                                    Style="{DynamicResource WlSecondaryButton}"
                                    Content="Добавить"
                                    Margin="8,0,0,0"
                                    Click="AddItem_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- ── Details ────────────────────────────────────────── -->
                    <TextBlock Style="{DynamicResource WlMonoLabel}"
                               controls:Type.Tracked="ДЕТАЛИ"
                               Foreground="{DynamicResource WlTextMuted}"
                               Margin="0,24,0,0" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Style="{DynamicResource WlCaption}" Text="Категория" />
                            <TextBox x:Name="CategoryBox"
                                     Style="{DynamicResource WlSmallInput}"
                                     Margin="0,6,0,0"
                                     MaxLength="40"
                                     Tag="Например: работа"
                                     AutomationProperties.Name="Категория" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Style="{DynamicResource WlCaption}" Text="Срок" />
                            <TextBox x:Name="DueBox"
                                     Style="{DynamicResource WlSmallInput}"
                                     Margin="0,6,0,0"
                                     Tag="дд.мм.гггг"
                                     LostFocus="Due_LostFocus"
                                     AutomationProperties.Name="Срок выполнения" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{DynamicResource WlTextButton}" Content="Сегодня" Tag="0" Click="DueShortcut_Click" />
                        <Button Style="{DynamicResource WlTextButton}" Content="Завтра" Tag="1" Click="DueShortcut_Click" Margin="4,0,0,0" />
                        <Button Style="{DynamicResource WlTextButton}" Content="Через неделю" Tag="7" Click="DueShortcut_Click" Margin="4,0,0,0" />
                        <Button Style="{DynamicResource WlTextButton}" Content="Убрать срок" Tag="clear" Click="DueShortcut_Click" Margin="4,0,0,0" />
                    </WrapPanel>

                    <TextBlock x:Name="CreatedText"
                               Style="{DynamicResource WlMonoLabel}"
                               Foreground="{DynamicResource WlTextMuted}"
                               Margin="0,20,0,24" />
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ Footer ══════════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9"
                    Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="DeleteButton"
                                Style="{DynamicResource WlDangerButton}"
                                Content="Удалить"
                                Click="Delete_Click" />
                        <CheckBox x:Name="CompletedBox"
                                  Style="{DynamicResource WlCheckBox}"
                                  Content="Выполнено"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  AutomationProperties.Name="Отметить выполненной" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource WlSecondaryButton}" Content="Отмена" Click="Cancel_Click" />
                        <Button Style="{DynamicResource WlPrimaryButton}" Content="Сохранить"
                                Margin="10,0,0,0" IsDefault="True" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

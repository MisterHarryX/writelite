<Window x:Class="WriteLite.Views.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WriteLite — индикатор"
        Width="76"
        Height="40"
        SizeToContent="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        FontFamily="{DynamicResource WlFont}">
    <!-- FloatingIndicator: pen (30) + gap 6 + badge (30), no chrome chrome -->
    <Grid Width="72" Height="36" Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <!-- Pen button (left in design) -->
        <Button x:Name="PenButton"
                Style="{DynamicResource WlPenButton}"
                Grid.Column="0"
                ToolTip="Меню WriteLite"
                Click="PenButton_Click">
            <Button.ContextMenu>
                <ContextMenu x:Name="PenMenu"
                             Style="{DynamicResource WlContextMenu}">
                    <MenuItem Style="{DynamicResource WlMenuItem}"
                              Header="Исправить все безопасные ошибки"
                              Click="ApplyAllMenuItem_Click">
                        <MenuItem.Icon>
                            <Viewbox Width="15" Height="15">
                                <Path Stroke="{DynamicResource WlTextSecondary}"
                                      StrokeThickness="1.6"
                                      Fill="Transparent"
                                      Data="M9 12l2 2 4-4 M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Style="{DynamicResource WlMenuItem}"
                              Header="Открыть панель WriteLite"
                              Click="OpenPanelMenuItem_Click">
                        <MenuItem.Icon>
                            <Viewbox Width="15" Height="15">
                                <Path Stroke="{DynamicResource WlTextSecondary}"
                                      StrokeThickness="1.6"
                                      Fill="Transparent"
                                      Data="M4 6h16 M4 12h16 M4 18h10"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Style="{DynamicResource WlMenuItem}"
                              Header="Открыть WriteLite"
                              Click="OpenMainMenuItem_Click">
                        <MenuItem.Icon>
                            <Viewbox Width="15" Height="15">
                                <Path Stroke="{DynamicResource WlTextSecondary}"
                                      StrokeThickness="1.6"
                                      Fill="Transparent"
                                      Data="M3 12h18 M12 3v18"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{DynamicResource WlMenuSeparator}" />
                    <MenuItem Style="{DynamicResource WlMenuItem}"
                              Header="Скрыть индикатор"
                              Click="HideIndicatorMenuItem_Click">
                        <MenuItem.Icon>
                            <Viewbox Width="15" Height="15">
                                <Path Stroke="{DynamicResource WlTextSecondary}"
                                      StrokeThickness="1.6"
                                      Fill="Transparent"
                                      Data="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z M9 12a3 3 0 1 0 6 0 3 3 0 0 0-6 0"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
            <!-- Feather icon -->
            <Viewbox Width="14" Height="14">
                <Canvas Width="24" Height="24">
                    <Path Stroke="White"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Data="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z M16 8 L2 22 M17.5 15 H9" />
                </Canvas>
            </Viewbox>
        </Button>

        <!-- Count / state badge -->
        <Button x:Name="CountButton"
                Style="{DynamicResource WlBadgeButton}"
                Grid.Column="2"
                Width="30"
                Height="30"
                ToolTip="Открыть WriteLite"
                Click="CountButton_Click">
            <Grid MinWidth="18" MinHeight="18">
                <!-- idle-errors: number -->
                <TextBlock x:Name="CountText"
                           Text="0"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <!-- idle-ok: check -->
                <Viewbox x:Name="OkIcon"
                         Width="16" Height="16"
                         Visibility="Collapsed"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Path Stroke="White"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Data="M5 13l4 4L19 7" />
                </Viewbox>
                <!-- analyzing: spinner -->
                <Viewbox x:Name="AnalyzingIcon"
                         Width="16" Height="16"
                         Visibility="Collapsed"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" />
                    </Viewbox.RenderTransform>
                    <Path Stroke="{DynamicResource WlBrand}"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          Fill="Transparent"
                          Data="M12 2a10 10 0 1 0 10 10" />
                </Viewbox>
                <!-- incomplete-dict: orange dot -->
                <Ellipse x:Name="DictDot"
                         Width="8" Height="8"
                         Fill="{DynamicResource WlBrand}"
                         Visibility="Collapsed"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Grid>
        </Button>
    </Grid>
</Window>

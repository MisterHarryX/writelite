<Window x:Class="WriteLite.Views.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WriteLite — индикатор"
        Width="72"
        Height="38"
        SizeToContent="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource WlFont}">
    <!--
        Floating indicator: a quiet dark pen chip for the menu, and an orange badge
        carrying the count. Only the count wears the accent, so the pair reads as
        "status + menu" instead of two competing buttons.
    -->
    <Grid Width="66" Height="32" Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="PenButton"
                Style="{DynamicResource WlPenButton}"
                Grid.Column="0"
                ToolTip="Меню WriteLite"
                AutomationProperties.Name="Меню WriteLite"
                Click="PenButton_Click">
            <Button.ContextMenu>
                <ContextMenu x:Name="PenMenu" Style="{DynamicResource WlContextMenu}">
                    <MenuItem Style="{DynamicResource WlMenuItem}"
                              Header="Исправить все безопасные ошибки"
                              Click="ApplyAllMenuItem_Click">
                        <MenuItem.Icon>
                            <Path Style="{DynamicResource WlIconSm}"
                                  Width="15" Height="15"
                                  Data="{DynamicResource WlIconCheck}"
                                  Stroke="{DynamicResource WlTextSecondary}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Style="{DynamicResource WlMenuItem}"
                              Header="Открыть панель замечаний"
                              Click="OpenPanelMenuItem_Click">
                        <MenuItem.Icon>
                            <Path Style="{DynamicResource WlIconSm}"
                                  Width="15" Height="15"
                                  Data="{DynamicResource WlIconPanel}"
                                  Stroke="{DynamicResource WlTextSecondary}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Style="{DynamicResource WlMenuItem}"
                              Header="Открыть WriteLite"
                              Click="OpenMainMenuItem_Click">
                        <MenuItem.Icon>
                            <Path Style="{DynamicResource WlIconSm}"
                                  Width="15" Height="15"
                                  Data="{DynamicResource WlIconHome}"
                                  Stroke="{DynamicResource WlTextSecondary}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{DynamicResource WlMenuSeparator}" />
                    <MenuItem Style="{DynamicResource WlMenuItem}"
                              Header="Скрыть индикатор"
                              Click="HideIndicatorMenuItem_Click">
                        <MenuItem.Icon>
                            <Path Style="{DynamicResource WlIconSm}"
                                  Width="15" Height="15"
                                  Data="{DynamicResource WlIconIgnore}"
                                  Stroke="{DynamicResource WlTextSecondary}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>

            <Path Style="{DynamicResource WlIconSm}"
                  Width="14" Height="14"
                  Data="{DynamicResource WlIconEditor}"
                  Stroke="{DynamicResource WlBrand}" />
        </Button>

        <Button x:Name="CountButton"
                Style="{DynamicResource WlBadgeButton}"
                Grid.Column="2"
                MinWidth="28"
                Height="28"
                Padding="7,0"
                ToolTip="Открыть панель замечаний"
                AutomationProperties.Name="Замечания WriteLite"
                Click="CountButton_Click">
            <Grid MinWidth="14" MinHeight="16">
                <!-- idle-errors: number -->
                <TextBlock x:Name="CountText"
                           Text="0"
                           Foreground="{DynamicResource WlOnBrand}"
                           FontFamily="{DynamicResource WlFontMono}"
                           FontWeight="Medium"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <!-- idle-ok: check -->
                <Path x:Name="OkIcon"
                      Style="{DynamicResource WlIconSm}"
                      Width="13" Height="13"
                      Data="{DynamicResource WlIconCheck}"
                      Stroke="{DynamicResource WlSuccess}"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                <!-- analyzing: spinner -->
                <Viewbox x:Name="AnalyzingIcon"
                         Width="14" Height="14"
                         Visibility="Collapsed"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" />
                    </Viewbox.RenderTransform>
                    <Path Stroke="{DynamicResource WlOnBrand}"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          Fill="Transparent"
                          Data="M12 2a10 10 0 1 0 10 10" />
                </Viewbox>
                <!-- incomplete-dict: single dot -->
                <Ellipse x:Name="DictDot"
                         Width="6" Height="6"
                         Fill="{DynamicResource WlOnBrand}"
                         Visibility="Collapsed"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Grid>
        </Button>
    </Grid>
</Window>

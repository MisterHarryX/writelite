<Window x:Class="WriteLite.Views.SuggestionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WriteLite.Controls"
        Title="WriteLite"
        Width="400"
        Height="540"
        MinWidth="360"
        MinHeight="280"
        MaxHeight="580"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource WlFont}">
    <!--
        The correction panel WriteLite shows next to a field in another application.
        Same card hierarchy as the in-app editor panel, at a size that can sit over
        someone else's window without taking it over.
    -->
    <Border Background="{DynamicResource WlBgBase}"
            BorderBrush="{DynamicResource WlLineStrong}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True"
            Effect="{DynamicResource WlShadowPopover}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ Header ══════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource WlBg}"
                    Padding="14,12,8,12"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:WriteLiteLogo LogoSize="22" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource WlMonoNumber}" Text="03" Margin="0,0,10,0" />
                            <TextBlock Text="Замечания"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource WlText}" />
                        </StackPanel>
                        <TextBlock x:Name="SummaryText"
                                   Style="{DynamicResource WlCaption}"
                                   Text="0 замечаний"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton"
                                Style="{DynamicResource WlIconButton}"
                                ToolTip="Настройки WriteLite"
                                AutomationProperties.Name="Настройки"
                                Click="SettingsButton_Click">
                            <Path Style="{DynamicResource WlIconSm}"
                                  Data="{DynamicResource WlIconSettings}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{DynamicResource WlIconButton}"
                                Click="CloseButton_Click"
                                ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть панель">
                            <Path Style="{DynamicResource WlIconSm}"
                                  Data="{DynamicResource WlIconClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Filters ═════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="0,0,0,1">
                <!-- Plain WrapPanel: inside a horizontally scrolling ScrollViewer it is
                     measured against infinite width and never wraps, clipping the last tab. -->
                <WrapPanel Margin="14,0">
                    <RadioButton x:Name="TabAll" Style="{DynamicResource WlTabButton}" Content="Все" IsChecked="True" GroupName="IssueTabs" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabOrthography" Style="{DynamicResource WlTabButton}" Content="Орфография" GroupName="IssueTabs" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabPunctuation" Style="{DynamicResource WlTabButton}" Content="Пунктуация" GroupName="IssueTabs" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabGrammar" Style="{DynamicResource WlTabButton}" Content="Грамматика" GroupName="IssueTabs" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabStyle" Style="{DynamicResource WlTabButton}" Content="Стиль" GroupName="IssueTabs" Checked="Tab_Checked" />
                </WrapPanel>
            </Border>

            <!-- ═══ Body ════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Background="{DynamicResource WlBgBase}">
                <ScrollViewer x:Name="IssuesScroller" VerticalScrollBarVisibility="Auto" Padding="14,14,10,14">
                    <StackPanel>
                        <Border x:Name="ReadonlyBanner"
                                Visibility="Collapsed"
                                Background="{DynamicResource WlInfoSoft}"
                                BorderBrush="{DynamicResource WlInfoBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,10">
                            <TextBlock Text="Поле доступно только для чтения. Исправления можно скопировать."
                                       Style="{DynamicResource WlCaption}"
                                       Foreground="{DynamicResource WlText}" />
                        </Border>

                        <Border x:Name="ApplyFeedbackBanner"
                                Visibility="Collapsed"
                                Background="{DynamicResource WlWarningSoft}"
                                BorderBrush="{DynamicResource WlWarningBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="ApplyFeedbackText"
                                           TextWrapping="Wrap"
                                           Style="{DynamicResource WlCaption}"
                                           Foreground="{DynamicResource WlText}" />
                                <Button x:Name="ApplyFeedbackCopy"
                                        Visibility="Collapsed"
                                        Content="Скопировать исправление"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Click="ApplyFeedbackCopy_Click" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DictBanner"
                                Visibility="Collapsed"
                                Background="{DynamicResource WlWarningSoft}"
                                BorderBrush="{DynamicResource WlWarningBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,10">
                            <TextBlock Text="Словарь ещё загружается. Точность проверки может быть ниже обычного."
                                       Style="{DynamicResource WlCaption}"
                                       Foreground="{DynamicResource WlText}" />
                        </Border>

                        <ItemsControl x:Name="IssuesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- category → change → explanation → actions -->
                                    <Border Style="{DynamicResource WlCorrectionCard}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="2" Height="10"
                                                        Background="{Binding CategoryBrush}"
                                                        CornerRadius="1"
                                                        Margin="0,0,9,0"
                                                        VerticalAlignment="Center" />
                                                <TextBlock Style="{DynamicResource WlCategoryLabel}"
                                                           controls:Type.Tracked="{Binding CategoryLabel}"
                                                           Foreground="{Binding CategoryBrush}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding BriefLabel}"
                                                       Style="{DynamicResource WlCaption}"
                                                       Foreground="{DynamicResource WlTextSecondary}"
                                                       Margin="0,9,0,0" />

                                            <WrapPanel Margin="0,9,0,0">
                                                <TextBlock Style="{DynamicResource WlOriginalText}"
                                                           Text="{Binding OriginalDisplay}" />
                                                <TextBlock Style="{DynamicResource WlChangeArrow}"
                                                           Visibility="{Binding ReplacementVisibility}" />
                                                <TextBlock Style="{DynamicResource WlReplacementText}"
                                                           Text="{Binding CorrectedDisplay}"
                                                           Visibility="{Binding ReplacementVisibility}" />
                                            </WrapPanel>

                                            <TextBlock Text="{Binding Issue.Explanation}"
                                                       Style="{DynamicResource WlExplanation}"
                                                       Margin="0,9,0,0" />

                                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                                <Button Style="{DynamicResource WlPrimaryButton}"
                                                        Content="Исправить"
                                                        MinHeight="28" Padding="12,0"
                                                        IsEnabled="{Binding CanApply}"
                                                        Tag="{Binding Issue}"
                                                        Click="ApplyIssueButton_Click" />
                                                <Button Style="{DynamicResource WlTextButton}"
                                                        Content="В словарь"
                                                        Margin="6,0,0,0"
                                                        Visibility="{Binding DictionaryVisibility}"
                                                        Tag="{Binding Issue}"
                                                        Click="AddToDictionary_Click" />
                                                <Button Style="{DynamicResource WlTextButton}"
                                                        Content="Игнорировать"
                                                        Margin="6,0,0,0"
                                                        Tag="{Binding Issue}"
                                                        Click="IgnoreIssue_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24">
                    <Path Style="{DynamicResource WlIconLg}"
                          Data="{DynamicResource WlIconCheck}"
                          Stroke="{DynamicResource WlSuccess}"
                          HorizontalAlignment="Center" />
                    <TextBlock Text="Замечаний не найдено"
                               Style="{DynamicResource WlCardTitle}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                    <TextBlock Text="Текст выглядит хорошо."
                               Style="{DynamicResource WlCaption}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel x:Name="AnalyzingState"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24">
                    <Viewbox Width="20" Height="20"
                             HorizontalAlignment="Center"
                             Margin="0,0,12,0"
                             RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform>
                            <RotateTransform x:Name="PanelSpinnerRotate" />
                        </Viewbox.RenderTransform>
                        <Path Stroke="{DynamicResource WlBrand}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              Fill="Transparent"
                              Data="M12 2a10 10 0 1 0 10 10" />
                    </Viewbox>
                    <TextBlock Text="Проверяем текст…"
                               Style="{DynamicResource WlCaption}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <!-- ═══ Footer ══════════════════════════════════════════════════ -->
            <Border x:Name="FooterBar"
                    Grid.Row="3"
                    Padding="14,12"
                    Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <Button x:Name="ApplyAllButton"
                            Style="{DynamicResource WlFooterPrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Content="Исправить все безопасные"
                            Click="ApplyAllButton_Click" />
                    <TextBlock x:Name="SafeCountText"
                               Style="{DynamicResource WlCaption}"
                               Margin="0,8,0,0" />
                    <ProgressBar x:Name="ProgressIndicator"
                                 Height="2"
                                 Margin="0,8,0,0"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource WlBrand}"
                                 Background="{DynamicResource WlLine}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

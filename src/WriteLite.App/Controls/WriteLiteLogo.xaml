<UserControl x:Class="WriteLite.Controls.WriteLiteLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <!--
        Header mark, matching the website: a small rounded square on the card
        surface with a hairline border, a warm-white W and a single orange nib dot.
        The tile is 5–6 px rounded rather than the previous 27 % — a heavily rounded
        squircle was the loudest thing in the old title bar.
    -->
    <Border x:Name="LogoFrame"
            Background="{DynamicResource WlSurface}"
            BorderBrush="{DynamicResource WlLineStrong}"
            BorderThickness="1"
            CornerRadius="5"
            SnapsToDevicePixels="True">
        <Viewbox Stretch="Uniform" Margin="4">
            <Canvas Width="24" Height="24">
                <!-- W -->
                <Path Data="M3.2,5.4 L7.4,18.6 L12,9.4 L16.6,18.6 L20.8,5.4"
                      Stroke="{DynamicResource WlText}"
                      StrokeThickness="2.1"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent" />
                <!-- Nib -->
                <Ellipse Canvas.Left="18.4" Canvas.Top="2.2"
                         Width="4.4" Height="4.4"
                         Fill="{DynamicResource WlBrand}" />
            </Canvas>
        </Viewbox>
    </Border>
</UserControl>

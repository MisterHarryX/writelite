<UserControl x:Class="WriteLite.Controls.WriteLiteLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- UI Spec §1: black square, ~27% radius, W + quill + brand tip -->
    <Border x:Name="LogoFrame"
            Background="#0B0B0C"
            BorderBrush="#303035"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Viewbox Stretch="Uniform" Margin="3">
                <Canvas Width="22" Height="22">
                    <TextBlock Canvas.Left="1"
                               Canvas.Top="2"
                               Text="W"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               FontWeight="ExtraBold"
                               Foreground="White" />
                    <Line X1="19" Y1="4" X2="13" Y2="16"
                          Stroke="White"
                          StrokeThickness="1.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Opacity="0.7" />
                    <Path Data="M16,9 Q18,7 19,4 Q16,6 13,14"
                          Stroke="White"
                          StrokeThickness="0.8"
                          Fill="Transparent"
                          Opacity="0.5" />
                    <Ellipse Canvas.Left="17.5"
                             Canvas.Top="1.5"
                             Width="4"
                             Height="4"
                             Fill="#FF7A1A" />
                </Canvas>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>

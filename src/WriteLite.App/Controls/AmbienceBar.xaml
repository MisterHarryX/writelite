<UserControl x:Class="WriteLite.Controls.AmbienceBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WriteLite.Controls"
             FontFamily="{DynamicResource WlFont}">
    <!--
        The ambience player, at the foot of the navigation rail.

        Sized to be a detail rather than a panel: 12 px mono eyebrow, one line of
        title, a 2 px progress rule and a row of three small transport buttons. It
        occupies the space the rail already wasted below the last navigation item.

        The equalizer is the only looping animation in WriteLite. Four bars scaling
        on their own offsets, and it is stopped — not merely hidden — the moment
        playback pauses, so a paused player costs nothing.
    -->
    <Border x:Name="Root"
            Background="Transparent"
            BorderBrush="{DynamicResource WlLineSoft}"
            BorderThickness="0,1,0,0"
            Padding="10,12,10,4"
            Visibility="Collapsed">
        <StackPanel>
            <!-- Eyebrow + equalizer. The label says what the sound is for. -->
            <Grid>
                <TextBlock Style="{DynamicResource WlMonoLabel}"
                           controls:Type.Tracked="АТМОСФЕРА"
                           Foreground="{DynamicResource WlTextMuted}"
                           VerticalAlignment="Center" />

                <StackPanel x:Name="Equalizer"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Height="12"
                            Visibility="Collapsed">
                    <Rectangle x:Name="Bar1" Width="2" Height="12" Fill="{DynamicResource WlBrand}"
                               Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Bar1Scale" ScaleY="0.35" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Bar2" Width="2" Height="12" Fill="{DynamicResource WlBrand}"
                               Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Bar2Scale" ScaleY="0.8" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Bar3" Width="2" Height="12" Fill="{DynamicResource WlBrand}"
                               Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Bar3Scale" ScaleY="0.5" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Bar4" Width="2" Height="12" Fill="{DynamicResource WlBrand}"
                               RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Bar4Scale" ScaleY="0.65" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>
            </Grid>

            <!-- Track. Artist only appears when the file name carries one. -->
            <TextBlock x:Name="TitleText"
                       Style="{DynamicResource WlCaption}"
                       Foreground="{DynamicResource WlTextSecondary}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Margin="0,9,0,0" />
            <TextBlock x:Name="ArtistText"
                       Style="{DynamicResource WlCaption}"
                       Foreground="{DynamicResource WlTextMuted}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Visibility="Collapsed"
                       Margin="0,2,0,0" />

            <!-- Progress. A rule, not a bar: it scales rather than resizing, so it
                 never triggers a layout pass while playing. -->
            <Border Height="2"
                    Background="{DynamicResource WlLine}"
                    CornerRadius="1"
                    Margin="0,10,0,0">
                <Border x:Name="ProgressFill"
                        Background="{DynamicResource WlBrand}"
                        CornerRadius="1"
                        HorizontalAlignment="Stretch"
                        RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                    </Border.RenderTransform>
                </Border>
            </Border>

            <!-- Transport.

                 Two columns rather than two aligned stacks: the buttons take what they
                 need and the volume slider absorbs whatever is left. With a fourth
                 button in the row a fixed 62 px slider overflowed the 216 px rail, and
                 a control that overflows at one width will overflow at another. -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="PreviousButton"
                            Style="{DynamicResource WlIconButton}"
                            Width="24" Height="24"
                            ToolTip="Предыдущий трек"
                            Click="Previous_Click"
                            AutomationProperties.Name="Предыдущий трек">
                        <Path Style="{DynamicResource WlIconSm}" Width="12" Height="12"
                              Data="{DynamicResource WlIconPrevious}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <Button x:Name="PlayButton"
                            Style="{DynamicResource WlIconButton}"
                            Width="26" Height="26"
                            Margin="2,0"
                            ToolTip="Включить атмосферу"
                            Click="PlayPause_Click"
                            AutomationProperties.Name="Воспроизведение">
                        <Path x:Name="PlayIcon" Style="{DynamicResource WlIconSm}" Width="13" Height="13"
                              Data="{DynamicResource WlIconPlay}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <Button x:Name="NextButton"
                            Style="{DynamicResource WlIconButton}"
                            Width="24" Height="24"
                            ToolTip="Следующий трек"
                            Click="Next_Click"
                            AutomationProperties.Name="Следующий трек">
                        <Path Style="{DynamicResource WlIconSm}" Width="12" Height="12"
                              Data="{DynamicResource WlIconNext}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <!-- Repeat. A mode rather than an action, so it is the one control
                         here that stays lit while it is on. -->
                    <ToggleButton x:Name="LoopButton"
                                  Style="{DynamicResource WlFormatToggle}"
                                  Width="24" Height="24"
                                  Margin="4,0,0,0"
                                  ToolTip="Повторять трек"
                                  Checked="Loop_Changed"
                                  Unchecked="Loop_Changed"
                                  AutomationProperties.Name="Повторять трек">
                        <Path Style="{DynamicResource WlIconSm}" Width="12" Height="12"
                              Data="{DynamicResource WlIconRepeat}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Path Style="{DynamicResource WlIconSm}" Width="12" Height="12"
                          Data="{DynamicResource WlIconVolume}"
                          Stroke="{DynamicResource WlTextMuted}"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0" />
                    <Slider x:Name="VolumeSlider"
                            Style="{DynamicResource WlSlider}"
                            MinWidth="34"
                            Width="46"
                            Minimum="0" Maximum="1"
                            VerticalAlignment="Center"
                            ToolTip="Громкость"
                            ValueChanged="Volume_Changed"
                            AutomationProperties.Name="Громкость" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="WlFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="WlFontDisplay">Segoe UI Variable Display, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="WlFontMono">Cascadia Mono, Consolas</FontFamily>
    <Style x:Key="WlPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource WlFontDisplay}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource WlText}" />
    </Style>
    <Style x:Key="WlPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource WlTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WlSectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource WlTextMuted}" />
    </Style>
</ResourceDictionary>

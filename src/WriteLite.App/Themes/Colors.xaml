<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WlBgBaseColor">#0C0D0F</Color>
    <Color x:Key="WlBgColor">#111318</Color>
    <Color x:Key="WlSurfaceColor">#171A20</Color>
    <Color x:Key="WlRaisedColor">#1D2129</Color>
    <Color x:Key="WlHoverColor">#252A33</Color>
    <Color x:Key="WlBorderColor">#2B303A</Color>
    <Color x:Key="WlTooltipBgColor">#171A20</Color>
    <Color x:Key="WlBrandColor">#FF7A00</Color>
    <Color x:Key="WlBrandHoverColor">#FF963F</Color>
    <Color x:Key="WlBrandPressedColor">#D95D00</Color>

    <SolidColorBrush x:Key="WlBgBase" Color="{StaticResource WlBgBaseColor}" />
    <SolidColorBrush x:Key="WlBg" Color="{StaticResource WlBgColor}" />
    <SolidColorBrush x:Key="WlSurface" Color="{StaticResource WlSurfaceColor}" />
    <SolidColorBrush x:Key="WlRaised" Color="{StaticResource WlRaisedColor}" />
    <SolidColorBrush x:Key="WlHover" Color="{StaticResource WlHoverColor}" />
    <SolidColorBrush x:Key="WlBorder" Color="{StaticResource WlBorderColor}" />
    <SolidColorBrush x:Key="WlTooltipBg" Color="{StaticResource WlTooltipBgColor}" />
    <SolidColorBrush x:Key="WlBrand" Color="{StaticResource WlBrandColor}" />
    <SolidColorBrush x:Key="WlBrandHover" Color="{StaticResource WlBrandHoverColor}" />
    <SolidColorBrush x:Key="WlBrandPressed" Color="{StaticResource WlBrandPressedColor}" />
    <SolidColorBrush x:Key="WlBrandDim" Color="#2EFF7A00" />
    <SolidColorBrush x:Key="WlBrandSoft" Color="#18FF7A00" />
    <SolidColorBrush x:Key="WlText" Color="#F5F6F7" />
    <SolidColorBrush x:Key="WlTextSecondary" Color="#A8AFBA" />
    <SolidColorBrush x:Key="WlTextMuted" Color="#747C89" />
    <SolidColorBrush x:Key="WlSuccess" Color="#42C77A" />
    <SolidColorBrush x:Key="WlSuccessText" Color="#42C77A" />
    <SolidColorBrush x:Key="WlSuccessSoft" Color="#1842C77A" />
    <SolidColorBrush x:Key="WlSuccessBorder" Color="#4242C77A" />
    <SolidColorBrush x:Key="WlWarning" Color="#E98A42" />
    <SolidColorBrush x:Key="WlWarningSoft" Color="#18E98A42" />
    <SolidColorBrush x:Key="WlWarningBorder" Color="#42E98A42" />
    <SolidColorBrush x:Key="WlInfo" Color="#A8AFBA" />
    <SolidColorBrush x:Key="WlInfoSoft" Color="#18A8AFBA" />
    <SolidColorBrush x:Key="WlInfoBorder" Color="#36A8AFBA" />
    <SolidColorBrush x:Key="WlError" Color="#ED6672" />
    <SolidColorBrush x:Key="WlDisabled" Color="#66747C89" />
    <SolidColorBrush x:Key="WlCatSpelling" Color="#E96B70" />
    <SolidColorBrush x:Key="WlCatSpellingBg" Color="#20E96B70" />
    <SolidColorBrush x:Key="WlCatPunctuation" Color="#E98A42" />
    <SolidColorBrush x:Key="WlCatPunctuationBg" Color="#20E98A42" />
    <SolidColorBrush x:Key="WlCatGrammar" Color="#E3A640" />
    <SolidColorBrush x:Key="WlCatGrammarBg" Color="#20E3A640" />
    <SolidColorBrush x:Key="WlCatStyle" Color="#6F94C9" />
    <SolidColorBrush x:Key="WlCatStyleBg" Color="#206F94C9" />
    <SolidColorBrush x:Key="WlCatFormatting" Color="#A8AFBA" />
    <SolidColorBrush x:Key="WlCatFormattingBg" Color="#18A8AFBA" />
</ResourceDictionary>

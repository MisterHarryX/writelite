<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WriteLite.Controls"
                    xmlns:wl="clr-namespace:WriteLite.Services">
    <!--
        Templates for the two structural blocks every page is built from.
        Keeping them here rather than inside each page is what makes the section
        numbering and the settings rhythm identical across the whole app.
    -->

    <wl:EditorialEase x:Key="WlEase" />

    <!-- ── Section header: 01  Проверка ────────────────────────────────────── -->
    <Style TargetType="{x:Type controls:SectionHeader}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SectionHeader}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{DynamicResource WlMonoNumber}"
                                       Text="{TemplateBinding Index}"
                                       Visibility="{TemplateBinding IndexVisibility}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource WlSectionTitle}"
                                           Text="{TemplateBinding Title}" />
                                <TextBlock Style="{DynamicResource WlSecondary}"
                                           Text="{TemplateBinding Description}"
                                           Visibility="{TemplateBinding DescriptionVisibility}"
                                           MaxWidth="560"
                                           HorizontalAlignment="Left"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <ContentPresenter Grid.Column="2"
                                              Content="{TemplateBinding Actions}"
                                              VerticalAlignment="Center"
                                              Margin="16,0,0,0" />
                        </Grid>

                        <Border Height="1"
                                Background="{DynamicResource WlLine}"
                                Margin="0,16,0,0"
                                Visibility="{TemplateBinding RuleVisibility}"
                                SnapsToDevicePixels="True" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Settings row ────────────────────────────────────────────────────── -->
    <!--
        No separator. Rows are held together by rhythm: 11 px of breathing room above
        and below each one, 40 px between groups, and the section header's rule as the
        only line on the page. The previous template drew a hairline under every row,
        which turned a settings page into twenty horizontal strips.

        The row lights up on hover. It is not clickable itself, but the highlight ties
        the label on the left to the control on the right — on a 720 px measure those
        two can otherwise read as unrelated.
    -->
    <Style TargetType="{x:Type controls:SettingRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingRow}">
                    <Grid>
                        <Border x:Name="Hover"
                                Background="{DynamicResource WlSurface}"
                                CornerRadius="5"
                                Margin="-12,0"
                                Opacity="0" />

                        <Grid Margin="0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Style="{DynamicResource WlBody}"
                                           Text="{TemplateBinding Label}" />
                                <TextBlock Style="{DynamicResource WlCaption}"
                                           Text="{TemplateBinding Description}"
                                           Visibility="{TemplateBinding DescriptionVisibility}"
                                           MaxWidth="460"
                                           HorizontalAlignment="Left"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Control}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

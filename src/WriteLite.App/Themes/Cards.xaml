<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Surfaces.

        Hierarchy comes from typography, spacing and hairlines — not from shadows.
        The only shadows in the product belong to surfaces that genuinely float
        above another window (popovers, menus, the system panel). In-page cards
        never carry one, which is also what keeps the redesign cheap to render.
    -->

    <DropShadowEffect x:Key="WlShadowPopover" BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.62" Color="#000000" />
    <DropShadowEffect x:Key="WlShadowMenu" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.52" Color="#000000" />
    <!-- Legacy aliases. -->
    <DropShadowEffect x:Key="WlShadowPanel" BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.62" Color="#000000" />
    <DropShadowEffect x:Key="WlShadowSm" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.34" Color="#000000" />

    <!-- Standard card: surface, hairline, 6 px. -->
    <Style x:Key="WlCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WlSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WlLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Legacy alias — kept so any view still asking for the old key stays on-system. -->
    <Style x:Key="WlPremiumCard" TargetType="Border" BasedOn="{StaticResource WlCard}" />

    <!-- Recessed container for lists and the writing canvas. -->
    <Style x:Key="WlInsetPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WlBgSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WlLineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Borderless grouping: hairline only, no box. Use for settings groups. -->
    <Style x:Key="WlGroup" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource WlLineSoft}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="WlHairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource WlLine}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Floating surface: the one place a shadow is justified. -->
    <Style x:Key="WlPopoverSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WlSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WlLineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{DynamicResource WlShadowPopover}" />
    </Style>

    <Style x:Key="WlPopupSurface" TargetType="Border" BasedOn="{StaticResource WlPopoverSurface}" />

    <!-- Quiet status chip: dot + label. The only rounded-pill shape kept in the app. -->
    <Style x:Key="WlStatusChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WlSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WlLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WlPopupSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WlSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{DynamicResource WlShadowPanel}" />
    </Style>
</ResourceDictionary>

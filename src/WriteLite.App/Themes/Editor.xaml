<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wl="clr-namespace:WriteLite.Services">
    <!--
        Document workspace surfaces.

        The formatting controls are the one place WriteLite risks looking like a
        word processor, so they are deliberately the quietest chrome in the
        product: 26 px targets, no borders at rest, no fills except on the state
        that is actually on, and the accent used once — to say "this is applied".

        The document itself keeps every pixel of contrast. The toolbar sits on the
        base background rather than on a raised surface so the eye passes over it
        and lands on the text.
    -->

    <CubicEase x:Key="WlEase" EasingMode="EaseOut" />

    <!-- ── Formatting toggle ───────────────────────────────────────────────── -->
    <!-- ToggleButton rather than a Button with manual state: bold being on is a
         state a screen reader should announce, not a colour a sighted user infers. -->
    <Style x:Key="WlFormatToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WlTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="wl:Motion.Press" Value="True" />
        <Setter Property="wl:Motion.PressScale" Value="0.94" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Hover"
                                Background="{DynamicResource WlSurface}"
                                CornerRadius="5"
                                Opacity="0" />
                        <Border x:Name="Checked"
                                Background="{DynamicResource WlBrandDim}"
                                BorderBrush="{DynamicResource WlLineAccent}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Opacity="0" />
                        <Border x:Name="Focus"
                                BorderBrush="{DynamicResource WlBrand}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WlText}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Checked" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource WlBrand}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toolbar rule ────────────────────────────────────────────────────── -->
    <!-- Groups the toolbar without boxing it. One hairline between related sets of
         controls does the work a border around each group would do noisily. -->
    <Style x:Key="WlToolbarRule" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Background" Value="{DynamicResource WlLine}" />
        <Setter Property="Margin" Value="7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Writing surface ─────────────────────────────────────────────────── -->
    <!-- No card, no border, no rounded box: this is a page, not a widget. The
         measured column is applied by the host, not here, so the same style can
         serve the editor and the AI preview. -->
    <Style x:Key="WlDocumentSurface" TargetType="RichTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WlText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource WlBrand}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource WlBrandDim}" />
        <Setter Property="SelectionOpacity" Value="1" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource WlFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- ── Diff ────────────────────────────────────────────────────────────── -->
    <!-- The AI preview marks what changed. Removed text keeps its strike so it is
         legible as "was", added text takes the accent wash rather than a green /
         red pair, which would be the only cool hue in the product. -->
    <SolidColorBrush x:Key="WlDiffAddedBg" Color="#2BEC6C08" />
    <SolidColorBrush x:Key="WlDiffRemovedBg" Color="#1FE3695A" />
    <SolidColorBrush x:Key="WlDiffRemovedFg" Color="#A0968F" />

    <!-- ── Word panel blocks ───────────────────────────────────────────────── -->
    <Style x:Key="WlPanelBlock" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Restated rather than BasedOn the mono label in Typography.xaml. A
         StaticResource inside a resource dictionary cannot see a sibling merged
         dictionary, only its own entries — a style that reaches across compiles
         cleanly and throws the first time the screen using it is shown. Every
         dictionary in this theme keeps its BasedOn chains local for that reason. -->
    <Style x:Key="WlPanelLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource WlFontMono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="LineHeight" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource WlTextMuted}" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <!-- ── Conversion result ───────────────────────────────────────────────── -->
    <Style x:Key="WlResultCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WlSuccessSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WlSuccessBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
</ResourceDictionary>

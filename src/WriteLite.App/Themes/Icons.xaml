    <!-- Ambience player. Drawn as outlines like everything else: a filled play
         triangle is the one shape that would break the line-work family, and at
         13 px the outline reads just as clearly. -->
    <Geometry x:Key="WlIconPlay">M8,5.4 L18.4,12 L8,18.6 Z</Geometry>
    <Geometry x:Key="WlIconPause">M9.2,5.6 V18.4 M14.8,5.6 V18.4</Geometry>
    <Geometry x:Key="WlIconPrevious">M17.6,5.6 L8.4,12 L17.6,18.4 Z M5.6,5.6 V18.4</Geometry>
    <Geometry x:Key="WlIconNext">M6.4,5.6 L15.6,12 L6.4,18.4 Z M18.4,5.6 V18.4</Geometry>

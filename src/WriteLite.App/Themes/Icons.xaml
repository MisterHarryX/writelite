    <Geometry x:Key="WlIconGoal">M12,20.6 A8.6,8.6 0 1 0 12,3.4 A8.6,8.6 0 0 0 12,20.6 Z M12,16.6 A4.6,4.6 0 1 0 12,7.4 A4.6,4.6 0 0 0 12,16.6 Z M12,13.2 A1.2,1.2 0 1 0 12,10.8 A1.2,1.2 0 0 0 12,13.2 Z</Geometry>

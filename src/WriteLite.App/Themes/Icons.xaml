    <Geometry x:Key="WlIconPin">M9.4,3.8 H14.6 L13.8,9.4 L17.2,12.6 H6.8 L10.2,9.4 Z M12,12.6 V20.2</Geometry>
    <Geometry x:Key="WlIconBookmark">M6.6,3.8 H17.4 V20.4 L12,16.2 L6.6,20.4 Z</Geometry>

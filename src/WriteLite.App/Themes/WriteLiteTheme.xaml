<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        WriteLite design system — composition root.

        Every colour, size, radius, duration and control template in the product
        resolves through these dictionaries. Nothing should be styled inline in a
        view: if a screen needs something new, it belongs in the matching
        dictionary below so the next screen inherits it.

        Merge order matters. Typography and Colors come first because later
        dictionaries reference them with StaticResource in BasedOn chains.

        See docs/DESIGN_AUDIT.md for the tokens and the reasoning behind them.
    -->
    <ResourceDictionary.MergedDictionaries>
        <!-- Foundations -->
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
        <ResourceDictionary Source="Spacing.xaml" />
        <ResourceDictionary Source="Animations.xaml" />
        <ResourceDictionary Source="Icons.xaml" />

        <!-- Surfaces and controls -->
        <ResourceDictionary Source="Cards.xaml" />
        <ResourceDictionary Source="Buttons.xaml" />
        <ResourceDictionary Source="Inputs.xaml" />
        <ResourceDictionary Source="Lists.xaml" />
        <ResourceDictionary Source="Sections.xaml" />
        <ResourceDictionary Source="Navigation.xaml" />
        <ResourceDictionary Source="Popups.xaml" />
        <ResourceDictionary Source="Scrollbars.xaml" />
        <ResourceDictionary Source="Tooltips.xaml" />

        <!-- Product surfaces -->
        <ResourceDictionary Source="Editor.xaml" />
        <ResourceDictionary Source="Corrections.xaml" />
        <ResourceDictionary Source="Dictionary.xaml" />
        <ResourceDictionary Source="Indicator.xaml" />
        <ResourceDictionary Source="Notes.xaml" />
        <ResourceDictionary Source="Reading.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
